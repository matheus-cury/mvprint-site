---
import '../styles/global.css';
import { SITE, CONTACT, ADDRESS } from '../config/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Gráfica e comunicação visual em Belo Horizonte. Plotagem veicular, envelopamento, adesivos, banners, fachadas e tapumes. Atendemos CBF, CEMIG, Citroën. Orçamento grátis!"
} = Astro.props;

// URL canônica dinâmica baseada na página atual
const canonicalURL = new URL(Astro.url.pathname, SITE.url).href;

// Schema LocalBusiness para SEO Local
const schemaData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "MV Print - Gráfica e Comunicação Visual",
  "legalName": "Mv Print Bh Digital Ltda",
  "image": "https://mvprint.com.br/images/logo-mvprint.png",
  "description": "Soluções completas em comunicação visual e gráfica rápida em Belo Horizonte. Plotagem veicular, envelopamento, adesivos, banners, fachadas, tapumes e muito mais.",
  "telephone": CONTACT.phone.number,
  "email": CONTACT.email,
  "url": "https://mvprint.com.br",
  "taxID": "33.770.142/0001-97",
  "foundingDate": "2019-05-29",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Bernardes Carvalho, 21, Fundos",
    "addressLocality": "Belo Horizonte",
    "addressRegion": "MG",
    "postalCode": "31360-130",
    "addressCountry": "BR",
    "addressNeighborhood": "Santa Terezinha"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": ADDRESS.geo.latitude,
    "longitude": ADDRESS.geo.longitude
  },
  "areaServed": [
    "Belo Horizonte",
    "Contagem",
    "Betim",
    "Nova Lima",
    "Santa Luzia",
    "Região Metropolitana de BH",
    "Minas Gerais"
  ],
  "priceRange": "$$",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "19:00"
    }
  ],
  "sameAs": [
    "https://www.instagram.com/mvprintbh",
    "https://www.facebook.com/mvprintbh",
    "https://wa.me/5531973024426"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços de Comunicação Visual",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Plotagem Veicular",
          "description": "Envelopamento e personalização de veículos, frotas e caminhões"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Comunicação Visual",
          "description": "Fachadas, letreiros, placas e sinalização empresarial"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Adesivos e Banners",
          "description": "Adesivos personalizados, banners, backdrops e lonas"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Gráfica Rápida",
          "description": "Cartões de visita, panfletos, folders e materiais impressos"
        }
      }
    ]
  }
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="7ieW-lLqqMtq57QOtO125RsuyKLoKbUH6YWZ5IOG8xU" />

    <!-- Keep the tracking configuration verified on the published site. -->
    {Astro.url.hostname === 'mvprint.com.br' && <>
      <script is:inline>
        if (location.hostname === 'mvprint.com.br') (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MKQL39R6');
      </script>
      <script is:inline>
        if (location.hostname === 'mvprint.com.br') (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,'clarity','script','v4zw84zw45');
      </script>
    </>}
    <meta name="description" content={description} />
    <meta name="keywords" content="gráfica belo horizonte, plotagem veicular bh, comunicação visual bh, adesivos personalizados bh, banner bh, fachada de loja belo horizonte, envelopamento de veículos bh, gráfica rápida bh, tapume bh, letreiro bh" />
    <meta name="author" content="MV Print" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="BR-MG" />
    <meta name="geo.placename" content="Belo Horizonte" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://mvprint.com.br/images/portfolio/ambientes-689498ae-10a6-4a37-95fb-307ec35bf8b4.jpg" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="MV Print" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mvprint.com.br/images/portfolio/ambientes-689498ae-10a6-4a37-95fb-307ec35bf8b4.jpg" />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Fontes: Instrument Serif (títulos), Instrument Sans (texto) e IBM Plex Mono (etiquetas) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400..700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />


    <meta name="theme-color" content="#F4EFE7" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/images/logo-mvprint.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <slot name="head" />

    <script is:inline>
      // Liga as animações só quando há JavaScript; se o script principal não
      // iniciar em 4 s (rede ruim), mostra todo o conteúdo sem animação.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (window.__mv) return;
        document.documentElement.classList.remove('js');
        document.querySelectorAll('template[data-press-fallback]').forEach(function (t) { t.parentNode.prepend(t.content.cloneNode(true)); });
      }, 4000);
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Pular para o conteúdo principal</a>
    <div class="read-progress" aria-hidden="true"></div>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true">
      <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="22" cy="22" r="11" /><path d="M22 2v40M2 22h40" /></svg>
    </div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-tag" aria-hidden="true"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
