---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="7ieW-lLqqMtq57QOtO125RsuyKLoKbUH6YWZ5IOG8xU" />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4CW944HDXN"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4CW944HDXN');

      // Rastrear cliques no WhatsApp como conversão
      document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('click', function(e) {
          const link = e.target.closest('a[href*="wa.me"]');
          if (link) {
            gtag('event', 'whatsapp_click', {
              'event_category': 'conversao',
              'event_label': link.textContent.trim() || 'WhatsApp',
              'value': 1
            });
          }
        });

        // Rastrear envio do formulário de contato
        const contactForm = document.getElementById('contact-form');
        if (contactForm) {
          contactForm.addEventListener('submit', function() {
            gtag('event', 'form_submit', {
              'event_category': 'conversao',
              'event_label': 'Formulário de Contato',
              'value': 1
            });
          });
        }
      });
    </script>
    <meta name="description" content={description} />
    <meta name="keywords" content="gráfica belo horizonte, plotagem veicular bh, comunicação visual bh, adesivos personalizados bh, banner bh, fachada de loja belo horizonte, envelopamento de veículos bh, gráfica rápida bh, tapume bh, letreiro bh" />
    <meta name="author" content="MV Print" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="BR-MG" />
    <meta name="geo.placename" content="Belo Horizonte" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://mvprint.com.br/images/portfolio/ambientes-689498ae-10a6-4a37-95fb-307ec35bf8b4.jpg" />
    <meta property="og:url" content="https://mvprint.com.br" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="MV Print" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mvprint.com.br/images/portfolio/ambientes-689498ae-10a6-4a37-95fb-307ec35bf8b4.jpg" />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Fontes Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Preload LCP Image (WebP com fallback JPG) -->
    <link rel="preload" as="image" href="/images/portfolio/ambientes-689498ae-10a6-4a37-95fb-307ec35bf8b4.webp" type="image/webp" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo-mvprint.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://mvprint.com.br" />

    <title>{title}</title>
  </head>
  <body class="bg-white">
    <a href="#main-content" class="skip-to-content">Pular para o conteúdo principal</a>
    <slot />
  </body>
</html>
