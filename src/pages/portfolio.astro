---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SplitText from '../components/SplitText.astro';
import { getWhatsAppLink } from '../config/site';
import { categories, totalPhotos } from '../data/portfolio';
import { fullWebp, imageSize, photoSrc } from '../lib/images';

// Dimensões reais de cada foto: a grade justificada mostra a foto inteira, sem cortes.
const gallery = await Promise.all(categories.map(async category => ({
  ...category,
  items: await Promise.all(category.images.map(async (image, index) => {
    const { width, height } = await imageSize(image);
    return { image, index, width, height, ratio: width / height };
  })),
})));
---

<Layout
  title="Portfólio | MV Print - Gráfica e Comunicação Visual em BH"
  description={`${totalPhotos} fotos de trabalhos da MV Print: plotagem veicular, adesivação de ambientes, fachadas, tapumes, lonas, vitrines e muito mais em Belo Horizonte.`}
>
  <Header />
  <main id="main-content" class="pf">
    <section class="pf-hero wrap" aria-labelledby="pf-title">
      <p class="rule"><span>(Acervo) — <b>Portfólio</b></span><Icon name="reg" class="reg-mark" /></p>
      <div class="pf-hero-grid">
        <SplitText as="h1" id="pf-title" class="display t-hero pf-title" text="O que já *passou pela prensa.*" />
        <div class="pf-hero-aside" data-reveal style="--d:.2s">
          <p class="lede">{totalPhotos} fotos em {gallery.length} categorias: de etiquetas a lonas gigantes, trabalhos para empresas de BH e de todo o Brasil.</p>
          <p class="pf-hint mono"><Icon name="loupe" /> Toque numa foto para ampliar</p>
        </div>
      </div>
    </section>

    <div class="pf-filters" id="portfolio-filters" hidden>
      <div class="pf-filters-inner" role="group" aria-label="Filtrar fotos por categoria">
        <button type="button" class="pf-chip filter-btn" data-filter="all" aria-pressed="true" aria-controls="portfolio-gallery">
          Todos <span class="mono">{totalPhotos}</span>
        </button>
        {gallery.map(category => (
          <button type="button" class="pf-chip filter-btn" data-filter={category.slug} aria-pressed="false" aria-controls="portfolio-gallery">
            {category.name} <span class="mono">{category.items.length}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="wrap">
      <p id="portfolio-status" class="pf-status mono" role="status" aria-live="polite" aria-atomic="true">{totalPhotos} fotos · Selecione uma imagem para ampliar.</p>

      <div id="portfolio-gallery">
        {gallery.map(category => (
          <section id={category.slug} class="pf-cat category-section" data-category={category.slug} data-label={category.name} aria-labelledby={`heading-${category.slug}`}>
            <header class="pf-cat-head">
              <h2 id={`heading-${category.slug}`} class="pf-cat-title display">{category.name}</h2>
              <p class="pf-cat-blurb">{category.blurb}</p>
              <p class="pf-cat-count mono">{String(category.items.length).padStart(2, '0')} fotos</p>
            </header>
            <div class="pf-grid">
              {category.items.map(item => (
                <a
                  href={photoSrc(item.image)}
                  class="pf-item portfolio-item"
                  style={`--r:${item.ratio.toFixed(4)}`}
                  data-category={category.slug}
                  data-full-image={fullWebp(item.image)}
                  data-title={`${category.name} — foto ${item.index + 1}`}
                  aria-label={`Ampliar ${category.name.toLowerCase()}, foto ${item.index + 1}`}
                  aria-haspopup="dialog"
                  data-cursor="view"
                  data-cursor-label="Ampliar"
                >
                  <ResponsiveImage
                    src={photoSrc(item.image)}
                    alt={`${category.name} ${item.index + 1} - Projeto de ${category.name.toLowerCase()} realizado pela MV Print em Belo Horizonte`}
                    width={item.width}
                    height={item.height}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                  />
                </a>
              ))}
              <span class="pf-fill" aria-hidden="true"></span>
            </div>
          </section>
        ))}
      </div>
    </div>

    <section class="wrap pf-cta" aria-labelledby="pf-cta-title">
      <div class="pf-cta-card sec-ink">
        <p class="eyebrow pf-cta-kicker">Gostou do que viu?</p>
        <h2 id="pf-cta-title" class="display pf-cta-title">A próxima foto <em>pode ser a sua.</em></h2>
        <p class="pf-cta-text">Conte a sua ideia e receba um orçamento rápido e sem compromisso.</p>
        <Button href={getWhatsAppLink('portfolio')} label="Solicitar orçamento" icon="whatsapp" variant="paper" size="lg" external />
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />

  <dialog id="lightbox" class="lb" aria-labelledby="lightbox-title" aria-describedby="lightbox-help">
    <div class="lb-top">
      <h2 id="lightbox-title" class="lb-title display">Visualização do portfólio</h2>
      <p id="lightbox-counter" class="lb-counter mono" role="status" aria-live="polite" aria-atomic="true"></p>
      <button id="lightbox-close" type="button" class="lb-btn lb-close" aria-label="Fechar imagem" autofocus>
        <span class="mono">Fechar</span><Icon name="close" />
      </button>
    </div>
    <p id="lightbox-help" class="sr-only">Use as setas para ver outras fotos desta seleção. Pressione Escape para fechar.</p>
    <figure id="lightbox-figure" class="lb-stage">
      <img id="lightbox-img" alt="" decoding="async" />
    </figure>
    <div class="lb-nav">
      <button id="lightbox-prev" type="button" class="lb-btn lb-arrow" aria-label="Foto anterior"><Icon name="arrow-left" /></button>
      <div class="lb-dots" aria-hidden="true"><span id="lightbox-bar"></span></div>
      <button id="lightbox-next" type="button" class="lb-btn lb-arrow" aria-label="Próxima foto"><Icon name="arrow-right" /></button>
    </div>
  </dialog>
</Layout>

<style>
  .pf-hero { padding-top: clamp(8rem, 14vw, 11rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .pf-hero-grid { display: grid; gap: 2rem 4rem; align-items: end; margin-top: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 1024px) { .pf-hero-grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, .7fr); } }
  .pf-title { font-size: clamp(3.4rem, 9vw, 9.5rem); }
  .pf-hero-aside { display: grid; gap: 1.2rem; }
  .pf-hint { display: inline-flex; align-items: center; gap: .5rem; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .pf-hint :global(svg) { width: 1.1rem; height: 1.1rem; }

  /* Filtros fixos no topo */
  .pf-filters {
    position: sticky; top: 88px; z-index: 40;
    padding: .75rem 0;
    background: rgb(244 239 231 / 86%);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-block: 1px solid var(--line);
    transition: top .7s var(--ease-expo);
  }
  :global(html.header-hidden) .pf-filters { top: 0; }
  .pf-filters-inner {
    display: flex; gap: .5rem;
    overflow-x: auto; scrollbar-width: none;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
  }
  .pf-filters-inner::-webkit-scrollbar { display: none; }
  .pf-chip {
    flex: none; display: inline-flex; align-items: center; gap: .5rem;
    min-height: 44px; padding: .5rem 1rem; border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-weight: 500; font-size: .92rem; white-space: nowrap;
    transition: background-color .3s, color .3s, box-shadow .3s;
  }
  .pf-chip .mono { font-size: .68rem; color: var(--color-muted); transition: color .3s; }
  .pf-chip:hover { box-shadow: inset 0 0 0 1px var(--color-ink); }
  .pf-chip[aria-pressed="true"] { background: var(--color-ink); color: var(--color-paper); box-shadow: none; }
  .pf-chip[aria-pressed="true"] .mono { color: rgb(244 239 231 / 65%); }

  .pf-status { margin: 1.6rem 0 0; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }

  /* Categorias */
  .pf-cat { padding-top: clamp(2.5rem, 5vw, 4rem); scroll-margin-top: 160px; }
  .pf-cat[hidden] { display: none !important; }
  .pf-cat-head {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: .4rem 2rem;
    padding-bottom: 1rem; margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .pf-cat-title { font-size: clamp(2.2rem, 4.5vw, 4rem); line-height: .95; grid-column: 1; }
  .pf-cat-blurb { grid-column: 1; color: var(--color-muted); }
  .pf-cat-count { grid-column: 2; grid-row: 1 / span 2; align-self: end; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }

  /* Grade justificada: cada foto cresce na proporção da própria largura */
  .pf-grid { --row: clamp(150px, 20vw, 290px); display: flex; flex-wrap: wrap; gap: clamp(6px, .8vw, 12px); }
  .pf-item {
    position: relative; display: block; overflow: hidden;
    flex: calc(var(--r) * 100) 1 calc(var(--r) * var(--row));
    aspect-ratio: var(--r);
    background: var(--color-paper-3);
    border-radius: 2px;
  }
  .pf-item :global(picture), .pf-item :global(img) { display: block; width: 100%; height: 100%; }
  .pf-item :global(img) { object-fit: cover; transition: transform 1s var(--ease-expo), filter .6s; }
  .pf-item::after {
    content: ""; position: absolute; inset: 0;
    box-shadow: inset 0 0 0 0 var(--color-magenta);
    transition: box-shadow .4s var(--ease-expo);
    pointer-events: none;
  }
  @media (hover: hover) {
    .pf-item:hover :global(img) { transform: scale(1.05); }
    .pf-item:hover::after { box-shadow: inset 0 0 0 4px var(--color-magenta); }
  }
  .pf-item:focus-visible { outline: 3px solid var(--color-magenta); outline-offset: 3px; }
  .pf-fill { flex: 100000 1 0; }
  @media (max-width: 639px) { .pf-grid { --row: 120px; } }

  :global(.js) .pf-item.is-enter { animation: pf-in .8s var(--ease-expo) both; animation-delay: var(--delay, 0s); }
  @keyframes pf-in { from { opacity: 0; transform: translate3d(0, 18px, 0) scale(.97); } }

  /* CTA */
  .pf-cta { padding-block: clamp(5rem, 10vw, 8rem); }
  .pf-cta-card {
    position: relative; overflow: hidden;
    display: grid; gap: 1.4rem; justify-items: start;
    padding: clamp(2rem, 6vw, 5rem);
  }
  .pf-cta-card::before {
    content: ""; position: absolute; right: -10%; top: -30%; width: 60%; aspect-ratio: 1;
    background-image: radial-gradient(circle, rgb(230 0 126 / 45%) 1.4px, transparent 2px);
    background-size: 14px 14px;
    mask-image: radial-gradient(circle, #000, transparent 70%);
    -webkit-mask-image: radial-gradient(circle, #000, transparent 70%);
    pointer-events: none;
  }
  .pf-cta-kicker { color: var(--color-yellow); }
  .pf-cta-title { font-size: clamp(2.8rem, 6.5vw, 6.5rem); line-height: .92; letter-spacing: -0.03em; max-width: 14ch; }
  .pf-cta-text { color: rgb(244 239 231 / 75%); max-width: 32rem; }

  /* ---------- Lightbox ---------- */
  .lb {
    width: 100%; max-width: none; height: 100%; height: 100dvh; max-height: none;
    margin: 0; padding: clamp(.75rem, 2vw, 1.5rem);
    border: 0;
    background: rgb(14 11 8 / 96%);
    color: var(--color-paper);
  }
  .lb[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; gap: 1rem; animation: lb-in .45s var(--ease-expo); }
  .lb::backdrop { background: rgb(0 0 0 / 60%); }
  @keyframes lb-in { from { opacity: 0; } }
  .lb-top { display: flex; align-items: center; gap: 1rem; width: min(100%, 90rem); margin-inline: auto; }
  .lb-title { flex: 1; min-width: 0; font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.1; }
  .lb-counter { font-size: .72rem; letter-spacing: .12em; color: rgb(244 239 231 / 60%); }
  .lb-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    min-width: 48px; min-height: 48px; padding: 0 .9rem; border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(244 239 231 / 25%);
    color: var(--color-paper);
    transition: background-color .3s, color .3s;
  }
  .lb-btn :global(svg) { width: 1.2rem; height: 1.2rem; }
  .lb-btn .mono { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; }
  .lb-btn:hover { background: var(--color-paper); color: var(--color-ink); }
  .lb-btn:disabled { opacity: .35; pointer-events: none; }
  .lb-stage { display: grid; place-items: center; min-height: 0; margin: 0; touch-action: pan-y; }
  #lightbox-img {
    max-width: 100%; max-height: 100%; object-fit: contain;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 80%);
    transition: opacity .35s, transform .6s var(--ease-expo);
  }
  #lightbox-img.is-leaving { opacity: 0; transform: translate3d(calc(var(--dir, 1) * -40px), 0, 0) scale(.98); }
  #lightbox-img.is-entering { opacity: 0; transform: translate3d(calc(var(--dir, 1) * 40px), 0, 0) scale(.98); transition: none; }
  .lb-nav { display: flex; align-items: center; gap: 1rem; width: min(100%, 90rem); margin-inline: auto; }
  .lb-dots { position: relative; flex: 1; height: 1px; background: rgb(244 239 231 / 18%); }
  .lb-dots span { position: absolute; left: 0; top: -1px; height: 3px; background: var(--color-magenta); width: var(--w, 10%); transform: translateX(var(--x, 0)); transition: transform .5s var(--ease-expo), width .3s; }
</style>
