---

<Layout title="Portfólio | MV Print - Gráfica e Comunicação Visual em BH">
  <!-- Header com fundo escuro -->
  <div class="bg-[#1D3557]">
    <header class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <a href="/" class="flex items-center">
          <img src="/images/logo-mvprint.png" alt="MV Print" class="h-12 w-auto" />
        </a>
        <nav class="hidden md:flex items-center space-x-8">
          <a href="/#servicos" class="text-white hover:text-[#F4A261] transition-smooth font-medium">Serviços</a>
          <a href="/#portfolio" class="text-white hover:text-[#F4A261] transition-smooth font-medium">Portfólio</a>
          <a href="/#sobre" class="text-white hover:text-[#F4A261] transition-smooth font-medium">Sobre</a>
          <a href="/#contato" class="text-white hover:text-[#F4A261] transition-smooth font-medium">Contato</a>
          <a href="https://wa.me/5531973024426?text=Olá! Vim pelo site da MV Print e gostaria de solicitar um orçamento." target="_blank" rel="noopener noreferrer" class="bg-[#25D366] hover:bg-green-600 text-white px-6 py-2 rounded-full font-semibold transition-smooth flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
        </nav>
      </div>
    </header>

    <!-- Hero da página -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Nosso Portfólio</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        {totalPhotos} trabalhos em {categories.length} categorias diferentes. Confira o que já fizemos para empresas de BH e região.
      </p>
    </div>
  </div>

  <main class="py-16 bg-[#F8F9FA]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filter buttons -->
      <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-12">
        <button class="filter-btn active px-4 sm:px-6 py-2 rounded-full font-medium text-sm sm:text-base transition-smooth bg-[#E91E8C] text-white" data-filter="all">
          Todos ({totalPhotos})
        </button>
        {categories.map((cat) => (
          <button class="filter-btn px-4 sm:px-6 py-2 rounded-full font-medium text-sm sm:text-base transition-smooth bg-white text-[#1D3557] hover:bg-[#E91E8C] hover:text-white" data-filter={cat.slug}>
            {cat.name} ({cat.items.length})
          </button>
        ))}
      </div>

      <!-- Portfolio por categoria -->
      {categories.map((category) => (
        <div class="category-section mb-16" data-category={category.slug}>
          <h2 class="text-2xl font-bold text-[#1D3557] mb-6 flex items-center gap-3">
            <span class="w-1 h-8 bg-[#E91E8C] rounded-full"></span>
            {category.name}
            <span class="text-sm font-normal text-gray-500">({category.items.length} fotos)</span>
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
            {category.items.map((item) => (
              <div class="portfolio-item group relative overflow-hidden rounded-xl aspect-square cursor-pointer bg-gray-200" data-category={category.slug}>
                <picture>
                  <source srcset={item.image.replace('.jpg', '.webp')} type="image/webp" />
                  <img
                    src={item.image}
                    alt={`${item.title} - MV Print BH`}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                    loading="lazy"
                    width="300"
                    height="300"
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <div class="absolute bottom-0 left-0 right-0 p-3">
                    <span class="text-[#F4A261] text-xs font-medium">{category.name}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- CTA -->
      <div class="text-center mt-12 bg-white rounded-2xl p-12 shadow-lg">
        <h3 class="text-2xl font-bold text-[#1D3557] mb-4">Gostou do que viu?</h3>
        <p class="text-[#6C757D] mb-6 max-w-xl mx-auto">
          Entre em contato conosco e transforme sua ideia em realidade. Orçamento rápido e sem compromisso!
        </p>
        <a
          href="https://wa.me/5531973024426?text=Olá! Vi o portfólio da MV Print e gostaria de solicitar um orçamento."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-green-600 text-white px-8 py-4 rounded-full font-semibold transition-smooth"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
