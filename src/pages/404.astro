---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getWhatsAppLink } from '../config/site';
---
<Layout title="Página não encontrada | MV Print" description="Encontre os serviços, trabalhos e contato da MV Print.">
  <Header />
  <main id="main-content" class="max-w-3xl mx-auto px-6 pt-40 pb-24 text-center">
    <p class="text-[#b81269] font-semibold mb-4">ERRO 404</p>
    <h1 class="text-4xl font-bold mb-5">Essa página não foi encontrada.</h1>
    <p class="text-slate-600 text-lg mb-8">Você pode voltar ao início para conhecer nossos serviços ou falar com a gente sobre seu projeto.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-full bg-[#1D3557] text-white px-6 py-4 font-semibold">Voltar ao início</a>
      <a href={getWhatsAppLink('default')} class="rounded-full bg-[#137a3d] text-white px-6 py-4 font-semibold">Falar no WhatsApp</a>
    </div>
  </main>
  <Footer />
</Layout>
