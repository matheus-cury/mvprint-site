---
// Seção FAQ - Perguntas Frequentes com Schema SEO
import { getWhatsAppLink } from '../config/site';

const whatsappLink = getWhatsAppLink('duvida');

const faqs = [
  {
    question: "Qual o prazo de entrega para adesivação?",
    answer: "O prazo varia de acordo com o projeto. Adesivos simples ficam prontos em 24-48h. Projetos maiores como envelopamento de veículos ou adesivação de ambientes levam de 3 a 7 dias úteis. Sempre informamos o prazo exato no orçamento."
  },
  {
    question: "Vocês fazem instalação?",
    answer: "Sim! Em Belo Horizonte e região metropolitana, oferecemos instalação inclusa ou com valor reduzido. Para outras localidades, enviamos o material com instruções de aplicação ou indicamos instaladores parceiros."
  },
  {
    question: "Qual a durabilidade dos adesivos?",
    answer: "Nossos adesivos têm durabilidade de 3 a 5 anos em ambientes externos, dependendo da exposição ao sol. Em ambientes internos, podem durar muito mais. Usamos materiais de alta qualidade com proteção UV."
  },
  {
    question: "Atendem empresas de todo o Brasil?",
    answer: "Sim! Enviamos para todo o Brasil via transportadora ou Correios. Já atendemos clientes em diversos estados. O frete é calculado no orçamento."
  },
  {
    question: "Como solicito um orçamento?",
    answer: "É simples! Envie uma mensagem pelo WhatsApp (31) 97302-4426 com detalhes do seu projeto: tipo de serviço, medidas aproximadas e referências visuais se tiver. Respondemos em até 24 horas."
  }
];

// Schema JSON-LD para FAQ
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="text-[#E91E8C] font-semibold text-sm uppercase tracking-wider">
        FAQ
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#1D3557] mt-2 mb-4">
        Perguntas Frequentes
      </h2>
      <p class="text-[#6C757D] text-lg">
        Tire suas dúvidas sobre nossos serviços
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-[#F8F9FA] rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <h3 class="text-lg font-semibold text-[#1D3557] pr-4">{faq.question}</h3>
            <span class="flex-shrink-0 w-8 h-8 bg-[#E91E8C]/10 rounded-full flex items-center justify-center group-open:rotate-180 transition-transform">
              <svg class="w-5 h-5 text-[#E91E8C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6">
            <p class="text-[#6C757D] leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <p class="text-[#6C757D] mb-4">Ainda tem dúvidas?</p>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20bd5a] text-white px-6 py-3 rounded-full font-semibold transition-smooth"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Falar com a gente
      </a>
    </div>
  </div>
</section>

<!-- FAQ Schema para SEO -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
