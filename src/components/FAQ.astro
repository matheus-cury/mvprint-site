---
// Perguntas frequentes (com schema FAQPage para SEO)
import Button from './Button.astro';
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { getWhatsAppLink } from '../config/site';

const whatsappLink = getWhatsAppLink('duvida');

const faqs = [
  {
    question: 'Qual o prazo de entrega para adesivação?',
    answer: 'O prazo varia de acordo com o projeto. Adesivos simples ficam prontos em 24-48h. Projetos maiores como envelopamento de veículos ou adesivação de ambientes levam de 3 a 7 dias úteis. Sempre informamos o prazo exato no orçamento.',
  },
  {
    question: 'Vocês fazem instalação?',
    answer: 'Sim! Em Belo Horizonte e região metropolitana, oferecemos instalação inclusa ou com valor reduzido. Para outras localidades, enviamos o material com instruções de aplicação ou indicamos instaladores parceiros.',
  },
  {
    question: 'Qual a durabilidade dos adesivos?',
    answer: 'Nossos adesivos têm durabilidade de 3 a 5 anos em ambientes externos, dependendo da exposição ao sol. Em ambientes internos, podem durar muito mais. Usamos materiais de alta qualidade com proteção UV.',
  },
  {
    question: 'Atendem empresas de todo o Brasil?',
    answer: 'Sim! Enviamos para todo o Brasil via transportadora ou Correios. Já atendemos clientes em diversos estados. O frete é calculado no orçamento.',
  },
  {
    question: 'Como solicito um orçamento?',
    answer: 'É simples! Envie uma mensagem pelo WhatsApp (31) 97302-4426 com detalhes do seu projeto: tipo de serviço, medidas aproximadas e referências visuais se tiver. Respondemos em até 24 horas.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<section id="faq" class="sec sec-paper-2 faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-aside">
      <p class="rule"><span><b>Dúvidas</b></span><Icon name="reg" class="reg-mark" /></p>
      <SplitText id="faq-title" class="display t-h2" text="Perguntas *frequentes.*" />
      <div class="faq-cta" data-reveal style="--d:.15s">
        <p class="lede">Não achou o que procurava? Chama a gente, a resposta é rápida.</p>
        <Button href={whatsappLink} label="Tirar uma dúvida" icon="whatsapp" variant="line" external />
      </div>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="qa" data-reveal style={`--d:${index * 0.06}s`}>
          <summary>
            <span class="qa-num mono">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="qa-q">{faq.question}</h3>
            <span class="qa-icon" aria-hidden="true"><Icon name="plus" /></span>
          </summary>
          <div class="qa-a"><p>{faq.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 7vw, 7rem); }
  @media (min-width: 1024px) {
    .faq-grid { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); align-items: start; }
  }
  .faq-cta { display: grid; gap: 1.5rem; justify-items: start; margin-top: 1.25rem; max-width: 26rem; }

  .faq-list { border-top: 1px solid var(--line-strong); }

  .qa { border-bottom: 1px solid var(--line-strong); interpolate-size: allow-keywords; }
  .qa summary {
    display: grid; grid-template-columns: 2.6rem minmax(0, 1fr) auto; align-items: center; gap: 1rem;
    padding: 1.5rem 0;
    cursor: pointer; list-style: none;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa-num { font-size: var(--fs-micro); letter-spacing: .1em; color: var(--color-muted); transition: color .3s; }
  .qa-q { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.45rem, 2.2vw, 2rem); line-height: 1.1; letter-spacing: -0.01em; transition: transform .6s var(--ease-expo); }
  .qa-icon {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: transform .6s var(--ease-expo), background-color .3s, color .3s;
  }
  .qa-icon :global(svg) { width: 1.1rem; height: 1.1rem; }
  .qa[open] .qa-icon { transform: rotate(135deg); background: var(--color-ink); color: var(--color-paper); }
  .qa[open] .qa-num { color: var(--title-accent); }
  @media (hover: hover) {
    .qa summary:hover .qa-q { transform: translateX(.4rem); }
    .qa summary:hover .qa-icon { background: var(--color-ink); color: var(--color-paper); }
  }
  .qa-a { padding: 0 3.5rem 1.8rem 3.6rem; color: var(--color-ink-2); max-width: 46rem; }
  @media (max-width: 640px) { .qa-a { padding: 0 0 1.6rem 3.6rem; } }

  .qa::details-content {
    block-size: 0; overflow: clip;
    transition: block-size .6s var(--ease-expo), content-visibility .6s allow-discrete;
  }
  .qa[open]::details-content { block-size: auto; }
</style>
