---
// Antes e depois. Se existir public/images/antes-depois/van-antes.jpg (mesmo
// enquadramento da foto da van da Infinit), o par da van entra sozinho no build.
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';

const vanBefore = '/images/antes-depois/van-antes.jpg';
const hasVan = fs.existsSync(path.resolve(process.cwd(), 'public' + vanBefore));
const van = 'envelopamento-d7ef4c16-a4ef-4383-b3a7-36a7de20549e';
const sizes = '(min-width: 1100px) 1040px, calc(100vw - 2.5rem)';
const pair = {
  title: 'Do branco *à marca na rua.*',
  text: 'Arraste e compare a van da Infinit Telecom antes e depois da plotagem completa.',
  caption: 'Infinit Telecom · Plotagem veicular',
  beforeAlt: 'Antes: van branca sem plotagem',
  afterAlt: 'Depois: van da Infinit Telecom plotada pela MV Print',
};
---

{hasVan && (<section id="antes-depois" class="sec ba-sec" aria-labelledby="ba-title">
  <div class="wrap">
    <p class="rule"><span><b>Antes &amp; depois</b></span><Icon name="reg" class="reg-mark" /></p>

    <div class="ba-head">
      <SplitText id="ba-title" class="display t-h2" text={pair.title} />
      <p class="lede" data-reveal style="--d:.15s">{pair.text}</p>
    </div>

    <div class="ba" data-ba data-cursor="drag" data-cursor-label="Arraste" data-reveal="clip" style="--pos:50%">
      <div class="ba-canvas">
        <picture class="ba-img">
          <source type="image/webp" srcset={`/images/optimized/${van}-960.webp 960w, /images/portfolio/${van}.webp 1600w`} sizes={sizes} />
          <img src={`/images/portfolio/${van}.jpg`} alt={pair.afterAlt} width="1600" height="1200" loading="lazy" decoding="async" />
        </picture>
        <picture class="ba-img ba-before">
          <img src={vanBefore} alt={pair.beforeAlt} width="1600" height="1200" loading="lazy" decoding="async" />
        </picture>
      </div>
      <span class="ba-tag ba-tag-l mono" aria-hidden="true">Antes</span>
      <span class="ba-tag ba-tag-r mono" aria-hidden="true">Depois</span>
      <div class="ba-handle" aria-hidden="true">
        <span class="ba-knob"><Icon name="drag" /></span>
      </div>
      <input class="ba-range" type="range" min="0" max="100" step="1" value="50" aria-label="Comparar instalação e resultado" />
    </div>

    <div class="ba-foot" data-reveal style="--d:.1s">
      <p class="mono">{pair.caption}</p>
      <p class="mono ba-hint"><Icon name="drag" /> Arraste para comparar</p>
    </div>
  </div>
</section>)}

<style>
  .ba-head {
    display: grid; gap: 1.5rem 4rem; align-items: end;
    margin: clamp(2rem, 4vw, 3.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 1024px) { .ba-head { grid-template-columns: minmax(0, 1.3fr) minmax(0, .9fr); } }

  .ba {
    position: relative;
    aspect-ratio: 4 / 3;
    width: min(100%, calc(84vh * 4 / 3));
    margin-inline: auto;
    overflow: hidden;
    border-radius: 4px;
    background: #2d6b3c;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }

  .ba-img, .ba-img img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ba-img img { object-fit: cover; pointer-events: none; }
  /* A foto final foi tirada mais de longe: amplia e desloca para o letreiro coincidir. */
  .ba-canvas { --s: 1; --ox: 50%; position: absolute; inset: 0; transform: scale(var(--s)); transform-origin: var(--ox) 10%; }
  .ba-before { clip-path: inset(0 calc(100% - (var(--ox) + (var(--pos) - var(--ox)) / var(--s))) 0 0); }

  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos);
    width: 2px; margin-left: -1px;
    background: var(--color-paper);
    box-shadow: 0 0 0 1px rgb(22 18 14 / 15%);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute; top: 50%; left: 50%;
    display: grid; place-items: center;
    width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%;
    background: var(--color-paper); color: var(--color-ink);
    box-shadow: 0 12px 30px -10px rgb(22 18 14 / 55%);
    transition: transform .5s var(--ease-expo), background-color .3s, color .3s;
  }
  .ba-knob :global(svg) { width: 26px; height: 26px; }
  .ba:hover .ba-knob, .ba.is-dragging .ba-knob { transform: scale(1.12); background: var(--color-magenta); color: #fff; }

  .ba-tag {
    position: absolute; top: 1rem;
    padding: .45rem .8rem; border-radius: 999px;
    background: rgb(22 18 14 / 72%); color: var(--color-paper);
    backdrop-filter: blur(6px);
    font-size: .68rem; letter-spacing: .12em; text-transform: uppercase;
    pointer-events: none;
    transition: opacity .3s;
  }
  .ba-tag-l { left: 1rem; }
  .ba-tag-r { right: 1rem; }

  .ba-range {
    position: absolute; left: 0; right: 0; bottom: 0;
    width: 100%; height: 44px; margin: 0;
    opacity: 0; pointer-events: none;
  }
  .ba:has(.ba-range:focus-visible) { outline: 2px solid var(--color-magenta); outline-offset: 4px; }

  .ba-foot { display: flex; justify-content: space-between; gap: 1rem; width: min(100%, calc(84vh * 4 / 3)); margin: 1rem auto 0; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .ba-hint { display: inline-flex; align-items: center; gap: .4rem; }
  .ba-hint :global(svg) { width: 1rem; height: 1rem; }
</style>
