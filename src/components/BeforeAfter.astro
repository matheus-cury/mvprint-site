---
// Antes e depois com fotos reais da mesma parede: instalação × resultado.
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';

const during = 'recortes-e374e2ba-e03a-4805-be0d-eb0c95701c28';
const after = 'recortes-bf3f9971-82a7-4e40-9a66-98d44b9248f5';
const sizes = '(min-width: 1100px) 1040px, calc(100vw - 2.5rem)';
// A foto final aparece ampliada (132,5%), então pede uma versão maior.
const afterSizes = '(min-width: 1100px) 1380px, calc(133vw - 3.3rem)';
---

<section id="antes-depois" class="sec ba-sec" aria-labelledby="ba-title">
  <div class="wrap">
    <p class="rule"><span>(03) — <b>Antes &amp; depois</b></span><Icon name="reg" class="reg-mark" /></p>

    <div class="ba-head">
      <SplitText id="ba-title" class="display t-h2" text="Do papel *à parede.*" />
      <p class="lede" data-reveal style="--d:.15s">
        Arraste e compare a instalação e o resultado do letreiro do Centro de Danças e Artes Luana Campos: recorte eletrônico em vinil, aplicado letra por letra.
      </p>
    </div>

    <div class="ba" data-ba data-cursor="drag" data-cursor-label="Arraste" data-reveal="clip" style="--pos:50%">
      <picture class="ba-img ba-after">
        <source type="image/webp" srcset={`/images/optimized/${after}-960.webp 960w, /images/portfolio/${after}.webp 1600w`} sizes={afterSizes} />
        <img src={`/images/portfolio/${after}.jpg`} alt="Depois: letreiro Luana Campos aplicado na parede verde" width="1600" height="1200" loading="lazy" decoding="async" />
      </picture>
      <picture class="ba-img ba-before">
        <source type="image/webp" srcset={`/images/optimized/${during}-960.webp 960w, /images/portfolio/${during}.webp 1600w`} sizes={sizes} />
        <img src={`/images/portfolio/${during}.jpg`} alt="Durante: instalador da MV Print aplicando o letreiro com máscara de transferência" width="1600" height="1200" loading="lazy" decoding="async" />
      </picture>
      <span class="ba-tag ba-tag-l mono" aria-hidden="true">Instalando</span>
      <span class="ba-tag ba-tag-r mono" aria-hidden="true">Pronto</span>
      <div class="ba-handle" aria-hidden="true">
        <span class="ba-knob"><Icon name="drag" /></span>
      </div>
      <input class="ba-range" type="range" min="0" max="100" step="1" value="50" aria-label="Comparar instalação e resultado" />
    </div>

    <div class="ba-foot" data-reveal style="--d:.1s">
      <p class="mono">Centro de Danças e Artes Luana Campos</p>
      <p class="mono ba-hint"><Icon name="drag" /> Arraste para comparar</p>
    </div>
  </div>
</section>

<style>
  .ba-head {
    display: grid; gap: 1.5rem 4rem; align-items: end;
    margin: clamp(2rem, 4vw, 3.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 1024px) { .ba-head { grid-template-columns: minmax(0, 1.3fr) minmax(0, .9fr); } }

  .ba {
    position: relative;
    aspect-ratio: 4 / 3;
    width: min(100%, calc(84vh * 4 / 3));
    margin-inline: auto;
    overflow: hidden;
    border-radius: 4px;
    background: #2d6b3c;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }

  .ba-img, .ba-img img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ba-img img { object-fit: cover; pointer-events: none; }
  /* A foto final foi tirada mais de longe: amplia e desloca para o letreiro coincidir. */
  .ba-after img { width: 132.5%; height: 132.5%; left: -23.2%; top: -19.6%; max-width: none; object-fit: fill; }
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }

  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos);
    width: 2px; margin-left: -1px;
    background: var(--color-paper);
    box-shadow: 0 0 0 1px rgb(22 18 14 / 15%);
    pointer-events: none;
  }
  .ba-knob {
    position: absolute; top: 50%; left: 50%;
    display: grid; place-items: center;
    width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%;
    background: var(--color-paper); color: var(--color-ink);
    box-shadow: 0 12px 30px -10px rgb(22 18 14 / 55%);
    transition: transform .5s var(--ease-expo), background-color .3s, color .3s;
  }
  .ba-knob :global(svg) { width: 26px; height: 26px; }
  .ba:hover .ba-knob, .ba.is-dragging .ba-knob { transform: scale(1.12); background: var(--color-magenta); color: #fff; }

  .ba-tag {
    position: absolute; top: 1rem;
    padding: .45rem .8rem; border-radius: 999px;
    background: rgb(22 18 14 / 72%); color: var(--color-paper);
    backdrop-filter: blur(6px);
    font-size: .68rem; letter-spacing: .12em; text-transform: uppercase;
    pointer-events: none;
    transition: opacity .3s;
  }
  .ba-tag-l { left: 1rem; }
  .ba-tag-r { right: 1rem; }

  .ba-range {
    position: absolute; left: 0; right: 0; bottom: 0;
    width: 100%; height: 44px; margin: 0;
    opacity: 0; pointer-events: none;
  }
  .ba:has(.ba-range:focus-visible) { outline: 2px solid var(--color-magenta); outline-offset: 4px; }

  .ba-foot { display: flex; justify-content: space-between; gap: 1rem; width: min(100%, calc(84vh * 4 / 3)); margin: 1rem auto 0; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .ba-hint { display: inline-flex; align-items: center; gap: .4rem; }
  .ba-hint :global(svg) { width: 1rem; height: 1rem; }
</style>
