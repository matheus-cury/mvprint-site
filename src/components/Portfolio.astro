---
// Trabalhos em destaque: grade uniforme de seis cartões.
import Button from './Button.astro';
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { featured, totalPhotos, categories } from '../data/portfolio';
import { fullWebp, imageSize, optimized, photoSrc } from '../lib/images';

const works = await Promise.all(featured.map(async item => ({ ...item, ...(await imageSize(item.image)) })));
// O cartão é 4:5 e a foto é recortada (cover) e ampliada (zoom): a imagem desenhada é
// mais larga que o cartão. O sizes considera isso para o navegador baixar a versão nítida.
const sizesFor = (work: (typeof works)[number]) => {
  const factor = Math.max(1, work.width / work.height / (4 / 5)) * work.zoom;
  return `(min-width: 1024px) ${Math.round(30 * factor)}vw, ${Math.round(46 * factor)}vw`;
};
---

<section id="portfolio" class="sec sec-ink featured" aria-labelledby="featured-title">
  <div class="wrap">
    <p class="rule"><span><b>Trabalhos</b></span></p>
    <div class="featured-head">
      <SplitText id="featured-title" class="display t-h2" text="Trabalhos que *viram paisagem.*" />
      <p class="lede" data-reveal style="--d:.15s">Uma seleção de projetos para marcas de BH e do Brasil. No portfólio completo são {totalPhotos} fotos em {categories.length} categorias.</p>
    </div>

    <ul class="works" role="list">
      {works.map((work, index) => (
        <li data-reveal style={`--d:${(index % 3) * 0.08}s`}>
          <a href={`/portfolio#${work.slug}`} class="work">
            <span class="work-media" style={`--fx:${work.focus[0] * 100}%;--fy:${work.focus[1] * 100}%;--z:${work.zoom}`}>
              <picture>
                <source type="image/webp" srcset={`${optimized(work.image, 480)} 480w, ${optimized(work.image, 960)} 960w, ${fullWebp(work.image)} ${work.width}w`} sizes={sizesFor(work)} />
                <img src={photoSrc(work.image)} alt={`${work.service} para ${work.client}, feito pela MV Print`} width={work.width} height={work.height} loading="lazy" decoding="async" />
              </picture>
            </span>
            <span class="work-meta">
              <span>
                <span class="work-client display">{work.client}</span>
                <span class="work-service">{work.service}</span>
              </span>
              <span class="work-arrow"><Icon name="arrow-up-right" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="works-cta" data-reveal>
      <Button href="/portfolio" label={`Ver os ${totalPhotos} trabalhos`} variant="paper" size="lg" />
    </div>
  </div>
</section>

<style>
  .featured-head { display: grid; gap: 1.25rem; justify-items: start; max-width: 52rem; margin: 0 0 clamp(2.5rem, 5vw, 4rem); }

  .works { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1rem, 2.5vw, 2rem); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1024px) { .works { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .work { display: block; }
  .work-media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 16px; background: #231d18; }
  .work-media :global(picture), .work-media :global(img) { display: block; width: 100%; height: 100%; }
  .work-media :global(img) {
    object-fit: cover; object-position: var(--fx) var(--fy);
    transform-origin: var(--fx) var(--fy); transform: scale(var(--z));
    transition: transform 1.1s var(--ease-expo);
  }
  .work-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
  .work-client { display: block; font-size: clamp(1.1rem, 1.5vw, 1.35rem); line-height: 1.15; }
  .work-service { display: block; margin-top: .3rem; font-size: var(--fs-micro); font-weight: 600; letter-spacing: var(--ls-micro); text-transform: uppercase; color: rgb(244 239 231 / 60%); }
  .work-arrow {
    display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-dark); transition: background-color .3s, color .3s, transform .5s var(--ease-expo);
  }
  .work-arrow :global(svg) { width: 1rem; height: 1rem; }
  @media (hover: hover) {
    .work:hover .work-media :global(img) { transform: scale(calc(var(--z) * 1.06)); }
    .work:hover .work-arrow { background: var(--color-paper); color: var(--color-ink); transform: rotate(45deg); }
  }
  @media (max-width: 599px) {
    .work-arrow { display: none; }
    .work-client { font-size: 1rem; }
    .work-service { letter-spacing: .06em; }
  }
  .works-cta { display: flex; justify-content: center; margin-top: clamp(2.5rem, 5vw, 4rem); }

  /* Computador: título e texto lado a lado, como nas outras seções. As fotos
     continuam grandes: aqui a foto é a estrela, então a seção passa de uma tela. */
  @media (min-width: 1024px) {
    .featured-head { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: end; column-gap: clamp(2.5rem, 6vw, 6rem); max-width: none; margin-bottom: clamp(1.75rem, 4.5vh, 3rem); }
  }
</style>
