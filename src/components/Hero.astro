---
import Button from './Button.astro';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { getWhatsAppLink } from '../config/site';
import { heroPrints, totalPhotos } from '../data/portfolio';
import { fullWebp, optimized, photoSrc } from '../lib/images';

const prints = heroPrints.map(print => ({ ...print, src: optimized(print.image, 960), full: fullWebp(print.image) }));
const first = heroPrints[0];
const pad = (value: number) => String(value).padStart(2, '0');
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-dots" aria-hidden="true"></div>

  <div class="wrap hero-grid">
    <div class="hero-copy" data-reveal-manual>
      <p class="hero-kicker eyebrow" data-hero-in style="--d:0s">
        <span class="hero-inks" aria-hidden="true"><i class="dot dot-c"></i><i class="dot dot-m"></i><i class="dot dot-y"></i><i class="dot dot-k"></i></span>
        Gráfica &amp; comunicação visual · Belo Horizonte
      </p>

      <h1 id="hero-title" class="display t-hero hero-title">
        <span class="line" style="--d:.08s"><span class="line-in">Você imagina.</span></span>
        <span class="line" style="--d:.2s"><span class="line-in">A gente <em class="reg" data-reg data-text="imprime.">imprime.</em></span></span>
      </h1>

      <p class="lede hero-lede">
        Adesivos, fachadas, plotagem de veículos, tapumes e impressos. Da arte à instalação, com o cuidado de quem vive de tinta e papel.
      </p>

      <div class="hero-actions" data-hero-in style="--d:.55s">
        <Button href={getWhatsAppLink('default')} label="Pedir orçamento" icon="whatsapp" size="lg" external />
        <a href="#portfolio" class="hero-more u-link">Ver trabalhos <Icon name="arrow-down" class="hero-more-icon" /></a>
      </div>

      <dl class="hero-facts" data-hero-in style="--d:.65s">
        <div><dt>Desde 2019</dt><dd>em Belo Horizonte</dd></div>
        <div><dt>+1.000</dt><dd>projetos entregues</dd></div>
        <div><dt>Todo o Brasil</dt><dd>envio de materiais</dd></div>
      </dl>
    </div>

    <figure class="press" data-press data-reveal-manual>
      <div class="press-sheet cropmarks">
        <div class="press-stage" data-cursor="hide">
          <!-- Foto comum só aparece sem JavaScript ou sem WebGL (evita baixar duas vezes). -->
          <noscript>
            <ResponsiveImage src={photoSrc(first.image)} alt={`${first.service} para ${first.client}, feito pela MV Print`} width={960} height={1200} loading="eager" sizes="(min-width: 1024px) 40vw, calc(100vw - 40px)" class="press-fallback" />
          </noscript>
          <template data-press-fallback>
            <ResponsiveImage src={photoSrc(first.image)} alt={`${first.service} para ${first.client}, feito pela MV Print`} width={960} height={1200} loading="eager" sizes="(min-width: 1024px) 40vw, calc(100vw - 40px)" class="press-fallback" />
          </template>
          <canvas class="press-canvas" role="img" aria-label={`${first.service} para ${first.client}, impresso em retícula`}></canvas>
          <div class="press-head" aria-hidden="true"><span class="press-carriage"><i></i><i></i><i></i><i></i></span></div>
          <svg class="press-loupe" viewBox="0 0 200 200" aria-hidden="true">
            <circle cx="100" cy="100" r="99" fill="none" stroke="currentColor" stroke-width="1.2" />
            {Array.from({ length: 48 }, (_, i) => {
              const angle = (i / 48) * Math.PI * 2;
              const inner = i % 4 === 0 ? 88 : 93;
              return <line x1={100 + Math.cos(angle) * inner} y1={100 + Math.sin(angle) * inner} x2={100 + Math.cos(angle) * 99} y2={100 + Math.sin(angle) * 99} stroke="currentColor" stroke-width="1" />;
            })}
            <path d="M100 92v16M92 100h16" stroke="currentColor" stroke-width="1" />
          </svg>
          <button type="button" class="press-toggle" data-press-toggle data-cursor="">
            <Icon name="loupe" class="press-toggle-icon" />
            <span data-press-hint>Ver foto original</span>
          </button>
        </div>
        <span class="press-mark press-mark-t" aria-hidden="true"><Icon name="reg" /></span>
        <span class="press-mark press-mark-b" aria-hidden="true"><Icon name="reg" /></span>
        <span class="press-mark press-mark-l" aria-hidden="true"><Icon name="reg" /></span>
        <span class="press-mark press-mark-r" aria-hidden="true"><Icon name="reg" /></span>
        <span class="press-slug mono" aria-hidden="true">MV PRINT — 4/0 CMYK</span>
      </div>

      <figcaption class="press-caption">
        <span class="press-count mono"><b data-press-index>01</b> / {pad(prints.length)}</span>
        <span class="press-label">
          <span class="press-client" data-press-client>{first.client}</span>
          <span class="press-service mono" data-press-service>{first.service}</span>
        </span>
        <span class="press-controls">
          <button type="button" class="press-btn" data-press-prev aria-label="Projeto anterior"><Icon name="arrow-left" /></button>
          <button type="button" class="press-btn" data-press-pause aria-label="Pausar troca automática" aria-pressed="false">
            <span class="press-timer" aria-hidden="true"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="16.5" /></svg></span>
            <Icon name="pause" class="icon-pause" /><Icon name="play" class="icon-play" />
          </button>
          <button type="button" class="press-btn" data-press-next aria-label="Próximo projeto"><Icon name="arrow-right" /></button>
        </span>
      </figcaption>
      <p class="sr-only" aria-live="polite" data-press-status></p>
      <script type="application/json" data-press-prints set:html={JSON.stringify(prints)} />
    </figure>
  </div>

  <div class="wrap hero-foot" data-reveal="fade" style="--d:.9s">
    <span class="hero-scroll mono"><span class="hero-scroll-line" aria-hidden="true"></span>Role para ver</span>
    <div class="hero-strip" aria-hidden="true">
      <span class="mono">Barra de controle</span>
      <span class="strip">
        <i style="--c:var(--color-cyan)"></i><i style="--c:var(--color-magenta)"></i><i style="--c:var(--color-yellow)"></i><i style="--c:var(--color-ink)"></i>
        <i style="--c:color-mix(in srgb, var(--color-cyan) 50%, white)"></i><i style="--c:color-mix(in srgb, var(--color-magenta) 50%, white)"></i><i style="--c:color-mix(in srgb, var(--color-yellow) 50%, white)"></i><i style="--c:color-mix(in srgb, var(--color-ink) 50%, white)"></i>
        <i style="--c:#2E3192"></i><i style="--c:#ED1C24"></i><i style="--c:#00A651"></i><i style="--c:#231F20"></i>
      </span>
      <span class="mono">{totalPhotos} trabalhos no portfólio</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(6.5rem, min(13vw, 17vh), 10.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    overflow: clip;
  }

  /* Retícula de fundo: um véu cor de papel esmaece os pontos (sem mask-image,
     que em conjunto com as animações gerava camadas fantasmas no Chrome). */
  .hero-dots {
    position: absolute; inset: 0 0 auto auto; z-index: -1; width: min(70vw, 900px); height: 100%;
    background:
      radial-gradient(ellipse 70% 60% at 85% 20%, rgb(244 239 231 / 0%) 0%, var(--color-paper) 70%),
      radial-gradient(circle, rgb(230 0 126 / 16%) 1.1px, transparent 1.6px) 0 0 / 13px 13px;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: minmax(0, 1.28fr) minmax(0, .92fr); }
  }

  .hero-kicker {
    display: inline-flex; align-items: center; gap: .9rem;
    color: var(--color-ink-2);
    margin-bottom: clamp(1.4rem, 2.5vw, 2.2rem);
  }
  .hero-inks { display: inline-flex; gap: .3rem; }

  .hero-title { margin-left: -.04em; }
  .hero-title .line { display: block; overflow: hidden; padding: .02em .12em .16em .04em; margin: -.02em -.12em -.16em -.04em; }
  .hero-title .line-in { display: block; }
  .hero-title .reg { font-style: italic; margin-right: -.04em; }
  :global(.js) .hero-title .line-in { transform: translate3d(0, 108%, 0); transition: transform 1.5s var(--ease-expo) var(--d, 0s); }
  :global(.js) .hero-title .line.is-in .line-in { transform: none; }
  .hero-title .line.is-done { overflow: visible; }

  :global(.js) [data-hero-in] { opacity: 0; transform: translate3d(0, 1.5rem, 0); transition: opacity 1s var(--ease-expo) var(--d, 0s), transform 1.3s var(--ease-expo) var(--d, 0s); }
  :global(.js) [data-hero-in].is-in { opacity: 1; transform: none; }

  .hero-lede { max-width: 34rem; margin-top: clamp(1.6rem, 3vw, 2.4rem); }

  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 2.2rem; }
  .hero-more { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; }
  .hero-more :global(.hero-more-icon) { width: 1rem; height: 1rem; transition: transform .5s var(--ease-expo); }
  .hero-more:hover :global(.hero-more-icon) { transform: translateY(3px); }

  .hero-facts {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem; max-width: 36rem;
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .hero-facts dt { font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 1.85rem); line-height: 1.05; letter-spacing: -0.01em; }
  .hero-facts dd { margin-top: .35rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }

  /* ---------- Prensa ---------- */

  .press { position: relative; margin: 0; width: 100%; max-width: 560px; justify-self: center; }
  @media (min-width: 1024px) { .press { justify-self: end; } }

  .press-sheet {
    position: relative;
    padding: 0;
    background: #FBF9F4;
    box-shadow: 0 1px 0 rgb(22 18 14 / 6%), 0 40px 70px -40px rgb(22 18 14 / 45%), 0 18px 30px -24px rgb(22 18 14 / 30%);
  }
  :global(.js) .press .press-sheet { opacity: 0; transform: translate3d(0, 2rem, 0) rotate(1.5deg); transition: opacity 1.1s var(--ease-expo) .3s, transform 1.6s var(--ease-expo) .3s; }
  :global(.js) .press.is-in .press-sheet { opacity: 1; transform: none; }

  .press-stage { position: relative; aspect-ratio: 4 / 5; overflow: hidden; touch-action: pan-y; }
  .press-stage :global(picture), .press-stage :global(.press-fallback) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .press-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .6s; }
  .press.gl .press-canvas { opacity: 1; }

  .press-head {
    position: absolute; left: -3%; right: -3%; top: 0; height: 0;
    pointer-events: none; opacity: 0;
    transition: opacity .3s;
  }
  .press-head.is-on { opacity: 1; }
  .press-head::before {
    content: ""; position: absolute; left: 0; right: 0; top: -1px; height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-ink) 12% 88%, transparent);
    box-shadow: 0 0 18px 4px rgb(251 249 244 / 90%);
  }
  .press-carriage {
    position: absolute; top: -13px; left: 0;
    display: flex; gap: 3px; padding: 5px 7px;
    border-radius: 6px; background: var(--color-ink);
    box-shadow: 0 8px 18px -6px rgb(22 18 14 / 60%);
    animation: carriage 0.9s var(--ease-quart) infinite alternate;
  }
  .press-carriage i { width: 9px; height: 16px; border-radius: 2px; }
  .press-carriage i:nth-child(1) { background: var(--color-cyan); }
  .press-carriage i:nth-child(2) { background: var(--color-magenta); }
  .press-carriage i:nth-child(3) { background: var(--color-yellow); }
  .press-carriage i:nth-child(4) { background: #4a423a; }
  @keyframes carriage { from { left: 3%; } to { left: calc(97% - 52px); } }

  .press-loupe {
    position: absolute; left: 0; top: 0; width: 200px; height: 200px;
    margin: -100px 0 0 -100px;
    color: rgb(22 18 14 / 75%);
    pointer-events: none; opacity: 0;
    transition: opacity .25s;
  }

  .press-toggle {
    position: absolute; left: 12px; bottom: 12px;
    display: inline-flex; align-items: center; gap: .45rem;
    padding: .5rem .8rem; border-radius: 999px;
    background: rgb(251 249 244 / 88%); color: var(--color-ink);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background .3s, color .3s, opacity .4s;
  }
  .press-toggle :global(.press-toggle-icon) { width: 1rem; height: 1rem; }
  .press-toggle:hover, .press-toggle[aria-pressed="true"] { background: var(--color-ink); color: var(--color-paper); }
  .press.no-gl .press-toggle, .press:not(.gl) .press-toggle { display: none; }
  .press.no-gl .press-controls { display: none; }

  .press-mark { position: absolute; width: 18px; height: 18px; color: var(--color-ink); opacity: .55; }
  .press-mark :global(svg) { width: 100%; height: 100%; }
  .press-mark-t { top: -32px; left: 50%; margin-left: -9px; }
  .press-mark-b { bottom: -32px; left: 50%; margin-left: -9px; }
  .press-mark-l { left: -32px; top: 50%; margin-top: -9px; }
  .press-mark-r { right: -32px; top: 50%; margin-top: -9px; }
  .press-slug {
    position: absolute; left: 0; top: -30px;
    font-size: .58rem; letter-spacing: .12em; color: var(--color-muted); white-space: nowrap;
  }
  @media (max-width: 640px) {
    .press-mark-l, .press-mark-r { display: none; }
    .press-slug { display: none; }
  }

  .press-caption {
    display: flex; align-items: center; gap: 1rem;
    margin-top: 2.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .press-count { font-size: .72rem; letter-spacing: .1em; color: var(--color-muted); }
  .press-count b { color: var(--color-ink); font-weight: 500; }
  .press-label { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .press-client { font-family: var(--font-display); font-size: 1.6rem; line-height: 1.05; }
  .press-service { font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); margin-top: .25rem; }
  .press-controls { display: flex; gap: .4rem; }
  .press-btn {
    position: relative; display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--color-ink);
    transition: background .3s, color .3s;
  }
  .press-btn :global(svg) { width: 1.05rem; height: 1.05rem; }
  .press-btn:hover { background: var(--color-ink); color: var(--color-paper); }
  .press-btn :global(.icon-play) { display: none; }
  .press-btn[aria-pressed="true"] :global(.icon-play) { display: block; }
  .press-btn[aria-pressed="true"] :global(.icon-pause) { display: none; }
  .press-timer { position: absolute; inset: 0; }
  .press-timer svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .press-timer circle {
    fill: none; stroke: var(--color-magenta); stroke-width: 1.5;
    stroke-dasharray: 103.7; stroke-dashoffset: 103.7;
  }
  .press-timer.is-running circle { animation: press-timer var(--t, 5s) linear forwards; }
  @keyframes press-timer { to { stroke-dashoffset: 0; } }

  /* ---------- Rodapé do hero ---------- */

  .hero-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .hero-scroll { display: inline-flex; align-items: center; gap: .8rem; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--color-muted); }
  .hero-scroll-line { position: relative; width: 1px; height: 38px; background: var(--line); overflow: hidden; }
  .hero-scroll-line::after { content: ""; position: absolute; inset: 0; background: var(--color-ink); animation: scroll-line 2.2s var(--ease-quart) infinite; }
  @keyframes scroll-line { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(100%); } }

  .hero-strip { display: flex; align-items: center; gap: 1rem; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .strip { display: flex; }
  .strip i { width: 22px; height: 12px; background: var(--c); }
  @media (max-width: 900px) {
    .hero-strip .mono { display: none; }
    .strip i { width: 16px; height: 10px; }
  }
</style>
