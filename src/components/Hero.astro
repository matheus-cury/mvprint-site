---
import { getWhatsAppLink } from '../config/site';
import ResponsiveImage from './ResponsiveImage.astro';
---

<section class="hero relative overflow-hidden bg-[#1D3557] text-white" aria-labelledby="hero-title">
  <div class="relative max-w-7xl mx-auto px-5 sm:px-8 pt-28 pb-12 lg:pt-40 lg:pb-24">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <p class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-200 mb-5">
          <span class="w-2 h-2 rounded-full bg-[#E91E8C]" aria-hidden="true"></span>
          Gráfica e comunicação visual em BH
        </p>
        <h1 id="hero-title" class="text-4xl sm:text-5xl xl:text-6xl font-bold tracking-tight leading-[1.12] mb-5">
          Você imagina.<br /><span class="text-[#ff83c5]">A gente imprime!</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-xl mb-7">
          Adesivos, fachadas, impressos e envelopamento de veículos.
          Dê vida à sua marca com a MV Print.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={getWhatsAppLink('default')} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#137a3d] hover:bg-[#106632] px-6 py-4 font-semibold transition-colors">
            Pedir orçamento no WhatsApp <span aria-hidden="true">↗</span>
          </a>
          <a href="#portfolio" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/35 hover:bg-white/10 px-6 py-4 font-semibold transition-colors">
            Conhecer os trabalhos <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="text-sm text-slate-300 mt-3">Conte sua ideia. O orçamento é sem compromisso.</p>
        <div class="grid grid-cols-3 gap-4 border-t border-white/15 mt-8 pt-6 max-w-lg">
          <div><p class="text-lg sm:text-2xl font-bold">Desde 2019</p><p class="text-xs sm:text-sm text-slate-300 mt-1">em Belo Horizonte</p></div>
          <div><p class="text-lg sm:text-2xl font-bold">Sua marca</p><p class="text-xs sm:text-sm text-slate-300 mt-1">em cada detalhe</p></div>
          <div><p class="text-lg sm:text-2xl font-bold">Todo o Brasil</p><p class="text-xs sm:text-sm text-slate-300 mt-1">envio de materiais</p></div>
        </div>
      </div>
      <figure class="relative rounded-2xl overflow-hidden border border-white/20 shadow-2xl bg-slate-800">
        <ResponsiveImage src="/images/portfolio/ambientes-689498ae-10a6-4a37-95fb-307ec35bf8b4.jpg" alt="Adesivação do ambiente corporativo da AeC realizada pela MV Print" width={960} height={720} loading="eager" fetchpriority="high" sizes="(min-width: 1280px) 576px, (min-width: 1024px) 45vw, calc(100vw - 40px)" class="w-full aspect-[4/3] object-cover" />
        <figcaption class="px-5 py-4 flex items-center justify-between gap-3 text-sm bg-[#142943]">
          <div><span class="block text-cyan-200 text-xs mb-1">UM DOS NOSSOS PROJETOS</span><span class="font-semibold">Comunicação visual · AeC</span></div>
          <a href="/portfolio#ambientes" class="shrink-0 underline underline-offset-4 hover:text-cyan-200">Ver mais <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
<style>
  .hero { background-image: radial-gradient(ellipse at 80% 20%, #007f9b33, transparent 60%), radial-gradient(ellipse at 0% 90%, #e91e8c18, transparent 50%); }
</style>
