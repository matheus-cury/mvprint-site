---
// Header com menu responsivo
import { getWhatsAppLink } from '../config/site';

const whatsappLink = getWhatsAppLink('default');
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img
          src="/images/logo-mvprint.png"
          alt="MV Print"
          width="400" height="265" class="h-14 w-auto"
        />
      </a>

      <!-- Menu Desktop -->
      <nav aria-label="Menu principal" class="hidden md:flex items-center space-x-8">
        <a href="/#servicos" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Serviços
        </a>
        <a href="/#portfolio" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Portfólio
        </a>
        <a href="/#sobre" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Sobre
        </a>
        <a href="/#contato" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Contato
        </a>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#137a3d] hover:bg-[#106632] text-white px-6 py-2 rounded-full font-semibold transition-smooth flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
      </nav>

      <!-- Menu Mobile Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden text-[#1D3557] p-3"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Menu Mobile -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <nav aria-label="Menu móvel" class="flex flex-col gap-1 [&>a]:py-3">
        <a href="/#servicos" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Serviços
        </a>
        <a href="/#portfolio" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Portfólio
        </a>
        <a href="/#sobre" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Sobre
        </a>
        <a href="/#contato" class="text-[#1D3557] hover:text-[#b81269] transition-smooth font-medium">
          Contato
        </a>
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#137a3d] text-white px-6 py-3 rounded-full font-semibold text-center flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const toggle = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  function setOpen(open: boolean, restoreFocus = false) {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    if (restoreFocus) toggle?.focus();
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
  header?.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, true);
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !header?.contains(event.target)) setOpen(false);
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', event => {
    if (event.matches) setOpen(false);
  });
</script>
