---
// Cabeçalho flutuante + menu em tela cheia (celular e tablet)
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { CONTACT, SOCIAL, getWhatsAppLink } from '../config/site';

const whatsappLink = getWhatsAppLink('default');
const links = [
  { href: '/#servicos', label: 'Serviços' },
  { href: '/#portfolio', label: 'Trabalhos' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#contato', label: 'Contato' },
];
const menuLinks = [...links, { href: '/portfolio', label: 'Portfólio completo' }];
---

<header id="header" class="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="MV Print, página inicial">
      <Logo class="brand-logo" />
    </a>

    <nav class="nav" aria-label="Menu principal">
      {links.map(link => (
        <a href={link.href} class="nav-link">
          <span class="roll"><span>{link.label}</span><span aria-hidden="true">{link.label}</span></span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a href="/portfolio" class="nav-link nav-portfolio">
        <span class="roll"><span>Portfólio</span><span aria-hidden="true">Portfólio</span></span>
      </a>
      <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-sm" data-magnetic="0.2">
        <span class="roll"><span>Orçamento</span><span aria-hidden="true">Orçamento</span></span>
        <span class="btn-icon" data-icon="whatsapp"><Icon name="whatsapp" /></span>
      </a>
      <button type="button" class="burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label="Menu">
  <div class="menu-top">
    <a href="/" class="brand" aria-label="MV Print, página inicial">
      <Logo class="brand-logo" />
    </a>
    <button type="button" class="menu-close" aria-label="Fechar menu" data-menu-close>
      <Icon name="close" />
    </button>
  </div>
  <nav class="menu-nav" aria-label="Menu">
    {menuLinks.map((link, index) => (
      <a href={link.href} class="menu-link" style={`--i:${index}`}>
        <span class="menu-num mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="menu-label">{link.label}</span>
        <Icon name="arrow-up-right" class="menu-arrow" />
      </a>
    ))}
  </nav>
  <div class="menu-foot">
    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-wa menu-cta">
      <span class="roll"><span>Pedir orçamento no WhatsApp</span><span aria-hidden="true">Pedir orçamento no WhatsApp</span></span>
      <span class="btn-icon" data-icon="whatsapp"><Icon name="whatsapp" /></span>
    </a>
    <div class="menu-contacts mono">
      <a href={`tel:${CONTACT.phone.number}`}>{CONTACT.phone.display}</a>
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>
    <div class="colorbar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 80;
    padding: 12px clamp(.75rem, 2vw, 1.25rem);
    pointer-events: none;
    transition: transform .7s var(--ease-expo);
    view-transition-name: site-header;
  }
  .site-header.is-hidden { transform: translate3d(0, -130%, 0); }

  .bar {
    pointer-events: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    max-width: var(--maxw);
    height: 64px;
    margin-inline: auto;
    padding: 0 8px 0 calc(var(--gutter) - clamp(.75rem, 2vw, 1.25rem));
    border-radius: 999px;
    border: 1px solid transparent;
    transition: background-color .5s, border-color .5s, box-shadow .5s, max-width .8s var(--ease-expo), padding .8s var(--ease-expo);
  }
  .site-header.is-scrolled .bar {
    max-width: 1120px;
    padding-left: 22px;
    background: rgb(244 239 231 / 78%);
    border-color: var(--line);
    box-shadow: 0 18px 40px -28px rgb(22 18 14 / 45%);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
  }

  .brand { display: inline-flex; flex: none; }
  .brand :global(.brand-logo) { display: block; width: auto; height: 38px; overflow: visible; transition: filter .45s var(--ease-expo); }
  /* No hover, a logo "sai de registro" como numa impressão desalinhada. */
  .brand:hover :global(.brand-logo) { opacity: .8; }

  /* Entrada da logo, uma vez por sessão: o "MV" é impresso da esquerda para a
     direita e as letras de "Print" sobem uma a uma. */
  :global(html.intro) .site-header :global(.logo-mv) { animation: logo-wipe 1.3s var(--ease-expo) .1s both; }
  :global(html.intro) .site-header :global(.logo-print path) {
    transform-box: fill-box;
    animation: logo-letter 1s var(--ease-expo) both;
    animation-delay: calc(.5s + var(--i, 0) * .07s);
  }
  @keyframes logo-wipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes logo-letter { from { opacity: 0; transform: translateY(55%); } }

  .nav { display: none; align-items: center; gap: clamp(1.25rem, 2.4vw, 2.4rem); }
  @media (min-width: 1024px) { .nav { display: flex; } }

  .nav-link {
    position: relative; display: inline-flex; align-items: flex-start; gap: .2rem;
    font-weight: 500; font-size: .95rem; letter-spacing: -0.005em;
  }
  .nav-link sup { font-family: var(--font-mono); font-size: .55rem; color: var(--color-muted); top: 0; line-height: 1.6; }
  .nav-link::after {
    content: ""; position: absolute; left: 0; bottom: -6px; width: 5px; height: 5px; border-radius: 50%;
    background: var(--color-magenta); transform: scale(0); transition: transform .4s var(--ease-back);
  }
  .nav-link.is-active::after { transform: scale(1); }

  .header-actions { display: flex; align-items: center; gap: .6rem; }
  .nav-portfolio { display: none; margin-right: .8rem; }
  @media (min-width: 1180px) { .nav-portfolio { display: inline-flex; } }

  .btn-sm { min-height: 46px; padding: .3rem .35rem .3rem 1.15rem; font-size: .9rem; }
  .btn-sm .btn-icon { width: 36px; height: 36px; }
  @media (max-width: 420px) {
    .btn-sm .roll { display: none; }
    .btn-sm { padding: .3rem; }
  }

  .burger {
    display: grid; place-content: center; gap: 6px;
    width: 46px; height: 46px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    background: var(--color-paper);
  }
  .burger span { display: block; width: 18px; height: 1.5px; background: var(--color-ink); transition: transform .4s var(--ease-expo); }
  .burger:hover span:first-child { transform: translateX(3px); }
  .burger:hover span:last-child { transform: translateX(-3px); }
  @media (min-width: 1024px) { .burger { display: none; } }
  :global(html:not(.js)) .burger { display: none; }

  /* ---------- Menu em tela cheia ---------- */

  .menu {
    position: fixed; inset: 0;
    width: 100%; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 12px clamp(.75rem, 2vw, 1.25rem) max(1.25rem, env(safe-area-inset-bottom));
    border: 0;
    background: var(--color-paper); color: var(--color-ink);
    clip-path: circle(0% at calc(100% - 44px) 44px);
    transition: clip-path .75s var(--ease-quart);
    overflow-y: auto;
  }
  .menu[open] { display: flex; flex-direction: column; }
  .menu.is-open { clip-path: circle(150% at calc(100% - 44px) 44px); }
  .menu::backdrop { background: transparent; }

  .menu-top { display: flex; align-items: center; justify-content: space-between; height: 66px; padding-left: calc(var(--gutter) - clamp(.75rem, 2vw, 1.25rem)); padding-right: 9px; }
  .menu-close {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%;
    background: var(--color-ink); color: var(--color-paper);
  }
  .menu-close :global(svg) { width: 20px; height: 20px; }

  .menu-nav { display: flex; flex-direction: column; margin-top: clamp(1.5rem, 6vh, 3rem); padding-inline: calc(var(--gutter) - clamp(.75rem, 2vw, 1.25rem)); }
  .menu-link {
    display: flex; align-items: center; gap: 1rem;
    padding: .7rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display); font-size: clamp(2.5rem, 10vw, 4.5rem); line-height: 1;
    letter-spacing: -0.02em;
    opacity: 0; transform: translate3d(0, 40%, 0);
    transition: opacity .6s var(--ease-expo), transform .9s var(--ease-expo), color .3s;
  }
  .menu.is-open .menu-link { opacity: 1; transform: none; transition-delay: calc(.18s + var(--i) * .06s); }
  .menu-num { font-size: .7rem; letter-spacing: .1em; color: var(--color-muted); align-self: flex-start; margin-top: .6rem; }
  .menu-label { flex: 1; }
  .menu-link :global(.menu-arrow) { width: 1.6rem; height: 1.6rem; opacity: .35; transition: transform .5s var(--ease-expo), opacity .3s; }
  .menu-link:hover { color: var(--color-magenta-deep); }
  .menu-link:hover :global(.menu-arrow) { opacity: 1; transform: rotate(45deg); }

  .menu-foot {
    margin-top: auto; padding: 2rem calc(var(--gutter) - clamp(.75rem, 2vw, 1.25rem)) 0;
    display: grid; gap: 1.5rem;
    opacity: 0; transition: opacity .6s .45s;
  }
  .menu.is-open .menu-foot { opacity: 1; }
  .menu-cta { justify-self: start; }
  .menu-contacts { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; font-size: .78rem; letter-spacing: .04em; color: var(--color-ink-2); }
  .menu-contacts a { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line-strong); }

  @media (prefers-reduced-motion: reduce) {
    .menu, .menu.is-open { clip-path: none; }
  }
</style>
