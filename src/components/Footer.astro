---
// Rodapé
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { CONTACT, ADDRESS, SOCIAL, HOURS, SITE, getWhatsAppLink } from '../config/site';

const currentYear = new Date().getFullYear();
const nav = [
  { href: '/#servicos', label: 'Serviços' },
  { href: '/#portfolio', label: 'Trabalhos' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#faq', label: 'Dúvidas' },
  { href: '/#contato', label: 'Contato' },
  { href: '/portfolio', label: 'Portfólio completo' },
];
---

<footer class="footer sec-ink" data-footer>
  <div class="colorbar footer-bar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="wrap">
    <div class="footer-cta">
      <p class="eyebrow footer-kicker">Tem um projeto em mente?</p>
      <a href={getWhatsAppLink('default')} target="_blank" rel="noopener noreferrer" class="footer-big display" data-cursor="view" data-cursor-label="WhatsApp">
        <span>Vamos conversar</span>
        <span class="footer-big-icon"><Icon name="arrow-up-right" /></span>
      </a>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <p class="footer-h mono">Navegação</p>
        <ul role="list">
          {nav.map(item => <li><a href={item.href} class="u-link">{item.label}</a></li>)}
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-h mono">Contato</p>
        <ul role="list">
          <li><a href={getWhatsAppLink('default')} target="_blank" rel="noopener noreferrer" class="u-link">WhatsApp {CONTACT.whatsapp.display}</a></li>
          <li><a href={`tel:${CONTACT.phone.number}`} class="u-link">Telefone {CONTACT.phone.display}</a></li>
          <li><a href={`mailto:${CONTACT.email}`} class="u-link">{CONTACT.email}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-h mono">Onde estamos</p>
        <address>
          {ADDRESS.street}<br />
          {ADDRESS.neighborhood}, {ADDRESS.city}/{ADDRESS.state}<br />
          CEP {ADDRESS.zip}
        </address>
        <p class="footer-hours">{HOURS.display}</p>
      </div>
      <div class="footer-col">
        <p class="footer-h mono">Redes</p>
        <ul role="list" class="footer-social">
          <li><a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram da MV Print"><Icon name="instagram" /></a></li>
          <li><a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook da MV Print"><Icon name="facebook" /></a></li>
        </ul>
      </div>
    </div>

    <!-- Logo gigante: duas chapas (ciano e magenta) atrás da logo desalinham com o mouse. -->
    <div class="footer-mark" data-reg-footer>
      <Logo tone="light" class="fm fm-c" />
      <Logo tone="light" class="fm fm-m" />
      <Logo tone="light" class="fm fm-main" label="MV Print" />
    </div>

    <div class="footer-bottom mono">
      <p>&copy; {currentYear} MV Print BH Digital LTDA · CNPJ {SITE.cnpj}</p>
      <p>Todos os direitos reservados · Impresso em Belo Horizonte</p>
    </div>
  </div>
</footer>

<style>
  .footer { position: relative; padding-top: clamp(4.5rem, 9vw, 8rem); overflow: clip; }
  .footer-bar { position: absolute; top: 0; left: 0; right: 0; height: 6px; }

  .footer-cta { display: grid; gap: 1.2rem; padding-bottom: clamp(3rem, 6vw, 5rem); border-bottom: 1px solid var(--line-dark); }
  .footer-kicker { color: rgb(244 239 231 / 60%); }
  .footer-big {
    display: inline-flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); justify-self: start;
    font-size: clamp(3.2rem, 10vw, 10rem); line-height: .9; letter-spacing: -0.035em;
    transition: color .4s;
  }
  .footer-big span:first-child { font-style: italic; }
  .footer-big-icon {
    display: grid; place-items: center; flex: none;
    width: clamp(3.6rem, 8vw, 7.5rem); aspect-ratio: 1; border-radius: 50%;
    background: var(--color-magenta); color: #fff;
    transition: transform .7s var(--ease-expo), background-color .4s, color .4s;
  }
  .footer-big-icon :global(svg) { width: 42%; height: 42%; }
  .footer-big:hover { color: var(--color-yellow); }
  .footer-big:hover .footer-big-icon { transform: rotate(45deg) scale(1.05); background: var(--color-yellow); color: var(--color-ink); }

  .footer-cols {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 2rem;
    padding: clamp(2.5rem, 5vw, 4rem) 0;
  }
  @media (max-width: 599px) { .footer-cols .footer-col:nth-child(2), .footer-cols .footer-col:nth-child(3) { grid-column: 1 / -1; } }
  @media (min-width: 900px) { .footer-cols { grid-template-columns: 1fr 1.3fr 1.2fr .6fr; } }
  .footer-h { font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: rgb(244 239 231 / 50%); margin-bottom: 1rem; }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .footer-col address { font-style: normal; color: rgb(244 239 231 / 85%); line-height: 1.6; }
  .footer-hours { margin-top: .8rem; color: rgb(244 239 231 / 60%); font-size: .95rem; }
  .footer-col a { color: rgb(244 239 231 / 88%); overflow-wrap: anywhere; }
  .footer-col a:hover { color: var(--color-paper); }
  .footer-social { display: flex !important; gap: .6rem !important; }
  .footer-social a {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-dark);
    transition: background-color .3s, color .3s;
  }
  .footer-social a:hover { background: var(--color-paper); color: var(--color-ink); }
  .footer-social :global(svg) { width: 1.15rem; height: 1.15rem; }

  .footer-mark {
    --rx: 0px; --ry: 0px;
    position: relative;
    margin: clamp(1.5rem, 4vw, 3.5rem) auto clamp(1.5rem, 3vw, 2.5rem);
    max-width: 1280px;
    isolation: isolate;
  }
  .footer-mark :global(.logo) { display: block; width: 100%; height: auto; }
  .footer-mark :global(.fm-c), .footer-mark :global(.fm-m) { position: absolute; inset: 0; mix-blend-mode: screen; }
  .footer-mark :global(.fm-c path), .footer-mark :global(.fm-c rect) { fill: #00A0E3 !important; stroke: none !important; }
  .footer-mark :global(.fm-m path), .footer-mark :global(.fm-m rect) { fill: #E6007E !important; stroke: none !important; }
  .footer-mark :global(.fm-c) { transform: translate3d(calc(var(--rx) * -1), calc(var(--ry) * -0.6), 0); }
  .footer-mark :global(.fm-m) { transform: translate3d(var(--rx), calc(var(--ry) * 0.5), 0); }
  .footer-mark :global(.fm-main) { position: relative; }

  .footer-bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem;
    padding: 1.4rem 0 1.6rem;
    border-top: 1px solid var(--line-dark);
    font-size: .68rem; letter-spacing: .1em; text-transform: uppercase;
    color: rgb(244 239 231 / 55%);
    position: relative; z-index: 1;
    background: var(--color-ink);
  }
</style>
