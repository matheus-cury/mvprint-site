---
// Rodapé
import Button from './Button.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { CONTACT, ADDRESS, SOCIAL, HOURS, SITE, getWhatsAppLink } from '../config/site';

const currentYear = new Date().getFullYear();
const nav = [
  { href: '/#servicos', label: 'Serviços' },
  { href: '/#portfolio', label: 'Trabalhos' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#faq', label: 'Dúvidas' },
  { href: '/#contato', label: 'Contato' },
  { href: '/portfolio', label: 'Portfólio completo' },
];
---

<footer class="footer sec-ink" data-footer>
  <div class="colorbar footer-bar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="MV Print, página inicial"><Logo tone="light" class="footer-logo-svg" /></a>
        <p class="footer-about">Gráfica e comunicação visual em Belo Horizonte desde 2019. Da arte à instalação, com envio para todo o Brasil.</p>
        <Button href={getWhatsAppLink('default')} label="Pedir orçamento" icon="whatsapp" variant="paper" external />
      </div>

      <nav class="footer-col" aria-label="Links do rodapé">
        <p class="footer-h">Navegação</p>
        <ul role="list" class="footer-nav">
          {nav.map(item => <li><a href={item.href} class="u-link">{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-h">Contato</p>
        <ul role="list">
          <li><a href={getWhatsAppLink('default')} target="_blank" rel="noopener noreferrer" class="u-link">WhatsApp {CONTACT.whatsapp.display}</a></li>
          <li><a href={`tel:${CONTACT.phone.number}`} class="u-link">Telefone {CONTACT.phone.display}</a></li>
          <li><a href={`mailto:${CONTACT.email}`} class="u-link">{CONTACT.email}</a></li>
        </ul>
        <ul role="list" class="footer-social">
          <li><a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram da MV Print"><Icon name="instagram" /></a></li>
          <li><a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook da MV Print"><Icon name="facebook" /></a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-h">Onde estamos</p>
        <address>
          {ADDRESS.street}<br />
          {ADDRESS.neighborhood}, {ADDRESS.city}/{ADDRESS.state}<br />
          CEP {ADDRESS.zip}
        </address>
        <p class="footer-hours">{HOURS.display}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} MV Print BH Digital LTDA · CNPJ {SITE.cnpj}</p>
      <p>Impresso em Belo Horizonte</p>
    </div>
  </div>
</footer>

<style>
  .footer { position: relative; padding-top: clamp(3.5rem, 7vw, 5.5rem); }
  .footer-bar { position: absolute; top: 0; left: 0; right: 0; height: 4px; }
  .footer-bar i:nth-child(4) { background: rgb(244 239 231 / 35%); }

  .footer-top {
    display: grid; gap: 2.5rem 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 640px) {
    .footer-top { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .footer-top { grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr)); gap: 2rem clamp(2rem, 4vw, 4rem); }
    .footer-brand { grid-column: auto; }
  }

  .footer-brand { display: grid; gap: 1.25rem; justify-items: start; align-content: start; max-width: 24rem; }
  .footer-logo { display: inline-flex; }
  .footer-logo :global(.footer-logo-svg) { display: block; width: auto; height: 44px; }
  .footer-about { color: rgb(244 239 231 / 72%); line-height: 1.6; }

  /* Mesmo estilo dos rótulos de seção, sem a bolinha. */
  .footer-h {
    margin-bottom: 1.1rem;
    font-size: .75rem; font-weight: 600; line-height: 1; letter-spacing: .14em; text-transform: uppercase;
    color: rgb(244 239 231 / 55%);
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  /* Área de toque maior sem afastar o sublinhado. */
  .footer-col ul a { position: relative; }
  .footer-col ul a::before { content: ""; position: absolute; inset: -8px -4px; }
  @media (max-width: 639px) { .footer-nav { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .footer-col a { color: rgb(244 239 231 / 88%); overflow-wrap: anywhere; }
  .footer-col a:hover { color: var(--color-paper); }
  .footer-col address { font-style: normal; color: rgb(244 239 231 / 88%); line-height: 1.6; }
  .footer-hours { margin-top: .8rem; color: rgb(244 239 231 / 60%); font-size: .95rem; line-height: 1.5; }

  .footer-col .footer-social { display: flex; gap: .6rem; margin-top: 1.4rem; }
  .footer-social a {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-dark);
    transition: background-color .3s, color .3s;
  }
  .footer-social a:hover { background: var(--color-paper); color: var(--color-ink); }
  .footer-social :global(svg) { width: 1.1rem; height: 1.1rem; }

  .footer-bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem;
    padding: 1.4rem 0 1.8rem;
    border-top: 1px solid var(--line-dark);
    font-size: .85rem; color: rgb(244 239 231 / 55%);
  }
</style>
