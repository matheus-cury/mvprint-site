---
// Sobre a MV Print
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { SITE } from '../config/site';
import { totalPhotos } from '../data/portfolio';
import { optimized } from '../lib/images';

const founded = new Date(`${SITE.foundingDate}T00:00:00-03:00`);
const years = Math.floor((Date.now() - founded.getTime()) / (365.25 * 24 * 3600 * 1000));

const prints: { image: string; alt: string; caption: string; crop?: string }[] = [
  { image: 'ambientes-52d794b7-5776-46d6-8e1e-d4311de13d8b', alt: 'Parede adesivada com desenho geométrico rosa e dourado', caption: 'Adesivo de parede' },
  { image: 'recortes-ae08b933-cb37-402e-a407-17a1e22a32e4', alt: 'Logo do Studio GS Fit em recorte preto sobre pastilhas', caption: 'Recorte · Studio GS Fit', crop: '--z:1.3;--o:60% 0%' },
  // Zoom com origem no alto esconde a marca d'água da câmera (canto inferior esquerdo).
  { image: 'recortes-e374e2ba-e03a-4805-be0d-eb0c95701c28', alt: 'Instalador da MV Print aplicando letreiro de recorte numa parede verde', caption: 'Instalação', crop: '--z:1.25;--o:60% 30%' },
];

const stats = [
  { value: 1000, prefix: '+', label: 'projetos entregues' },
  { value: 200, prefix: '+', label: 'empresas atendidas' },
  { value: totalPhotos, prefix: '', label: 'fotos no portfólio' },
  { value: years, prefix: '', label: 'anos de estrada' },
];

const features = [
  { title: 'Qualidade garantida', text: 'Materiais de primeira linha.' },
  { title: 'Entrega rápida', text: 'Prazos que cabem no seu projeto.' },
  { title: 'Atendimento personalizado', text: 'Cada projeto é único.' },
  { title: 'Todo o Brasil', text: 'Enviamos para todo o território.' },
];
const format = (value: number) => value.toLocaleString('pt-BR');
---

<section id="sobre" class="sec about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-prints" aria-label="Alguns trabalhos da MV Print" role="group">
        {prints.map((print, index) => (
          <figure class={`print print-${index + 1}`} data-parallax={index === 1 ? 0.08 : undefined}>
            <span class="tape" aria-hidden="true"></span>
            <span class="print-media" style={print.crop}><img src={optimized(print.image, 480)} alt={print.alt} width="480" height="360" loading="lazy" decoding="async" /></span>
            <figcaption class="mono">{print.caption}</figcaption>
          </figure>
        ))}
      </div>

      <div class="about-copy">
        <div>
          <p class="rule"><span><b>Sobre</b></span><Icon name="reg" class="reg-mark" /></p>
          <SplitText id="about-title" class="display t-h2" text="Uma gráfica de BH *com a mão na tinta.*" />
        </div>
        <div class="about-text" data-reveal style="--d:.15s">
          <p>Desde 2019, a <strong>MV Print</strong> transforma ideias em comunicação visual de qualidade. Nascemos em Belo Horizonte para oferecer soluções completas em impressão e comunicação visual para empresas de todos os portes.</p>
          <p>Do cartão de visita ao envelopamento completo de frotas, nossa equipe dá vida ao seu projeto com qualidade, agilidade e preço justo.</p>
        </div>

        <ul class="features" role="list">
          {features.map((feature, index) => (
            <li data-reveal style={`--d:${0.1 + index * 0.07}s`}>
              <span><strong>{feature.title}</strong><span class="feature-text">{feature.text}</span></span>
            </li>
          ))}
        </ul>

        <dl class="stats">
          {stats.map((stat, index) => (
            <div class="stat" data-reveal style={`--d:${index * 0.08}s`}>
              <dt class="stat-label">{stat.label}</dt>
              <dd class="stat-value tabular">
                {stat.prefix}<span data-count={stat.value}>{format(stat.value)}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid; gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }
  @media (min-width: 1024px) { .about-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); } }

  /* Colagem em grade de 12 colunas: cada foto ocupa 7. A 2ª desce e cobre só a
     borda da 1ª; a 3ª começa logo abaixo da 1ª, então nenhuma legenda fica tampada. */
  .about-prints { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); max-width: 620px; width: 100%; justify-self: center; padding: 14px 6px 0; }
  .print {
    position: relative; margin: 0;
    align-self: start;
    padding: 3.2% 3.2% 0;
    background: #FCFAF6;
    box-shadow: 0 1px 1px rgb(22 18 14 / 8%), 0 28px 45px -26px rgb(22 18 14 / 50%);
    transform: translate3d(0, var(--py, 0), 0) rotate(var(--r));
    transition: transform 1.2s var(--ease-expo);
  }
  .print-media { display: block; overflow: hidden; aspect-ratio: 4 / 3; }
  .print img { width: 100%; height: 100%; object-fit: cover; transform: scale(var(--z, 1)); transform-origin: var(--o, 50% 50%); }
  .print figcaption { padding: .7rem 0 .8rem; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
  .print-1 { --r: -4deg; grid-column: 1 / 8; grid-row: 1; z-index: 1; }
  .print-2 { --r: 3deg; grid-column: 6 / 13; grid-row: 1; margin-top: 30%; z-index: 3; }
  .print-3 { --r: -2deg; grid-column: 1 / 8; grid-row: 2; margin-top: -26%; z-index: 2; }
  .about-prints:hover .print { --r: 0deg; }
  .tape {
    position: absolute; top: -12px; left: 50%; width: 88px; height: 26px; margin-left: -44px;
    background: rgb(255 235 170 / 55%);
    box-shadow: 0 1px 2px rgb(22 18 14 / 8%);
    transform: rotate(-3deg);
    backdrop-filter: blur(1px);
  }
  .print-2 .tape { transform: rotate(4deg); background: rgb(160 220 245 / 50%); }
  .print-3 .tape { transform: rotate(-6deg); background: rgb(245 170 205 / 50%); }

  .about-copy { display: grid; gap: 1.8rem; }
  @media (max-width: 1023px) { .about-copy { order: -1; } }
  .about-text { display: grid; gap: 1rem; max-width: 38rem; color: var(--color-ink-2); font-size: 1.1rem; line-height: 1.65; }
  .about-text strong { color: var(--color-ink); font-weight: 600; }

  .features { list-style: none; margin: .6rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .features li { display: flex; gap: .8rem; padding: 1.1rem .8rem 1.1rem 0; border-bottom: 1px solid var(--line); }
  .features li::before { content: ""; flex: none; width: .5rem; height: .5rem; margin-top: .5rem; border-radius: 50%; background: var(--title-accent); }
  .features li:nth-child(odd) { border-right: 1px solid var(--line); }
  .features li:nth-child(even) { padding-left: 1rem; }
  .features strong { display: block; font-weight: 600; line-height: 1.3; }
  .feature-text { display: block; font-size: .92rem; color: var(--color-muted); margin-top: .2rem; }
  @media (max-width: 520px) {
    .features { grid-template-columns: 1fr; }
    .features li:nth-child(odd) { border-right: 0; }
    .features li:nth-child(even) { padding-left: 0; }
  }

  .stats {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: .6rem 0 0;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 900px) { .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stat { padding: 1.4rem 1rem 0 0; display: flex; flex-direction: column-reverse; gap: .6rem; }
  .stat + .stat { padding-left: 1rem; border-left: 1px solid var(--line); }
  @media (max-width: 899px) {
    .stats .stat:nth-child(odd) { border-left: 0; padding-left: 0; }
    .stats .stat:nth-child(n+3) { margin-top: 1.4rem; }
  }
  .stat-label { font-size: .85rem; color: var(--color-muted); }
  .stat-value { margin: 0; font-family: var(--font-sans); font-weight: 600; font-size: clamp(2.2rem, 3.6vw, 3.2rem); line-height: 1; letter-spacing: -0.03em; }

  /* Computador: colagem e texto na altura que sobra da tela, números em linha. */
  @media (min-width: 1024px) {
    .about-prints { max-width: min(620px, calc(var(--frame) / 1.12)); }
    .about-copy { gap: clamp(1rem, 2.6vh, 1.8rem); }
    .about-text { gap: .8rem; font-size: clamp(1rem, 1.9vh, 1.1rem); }
    .features li { padding-block: clamp(.6rem, 1.6vh, 1.1rem); }
    .stat { padding-top: 1rem; }
    .stat-value { font-size: clamp(1.8rem, 2.5vw, 2.4rem); }
  }

  @media (min-width: 1024px) and (max-height: 700px) {
    .about-text { line-height: 1.5; }
    .features li { padding-block: .45rem; }
    .feature-text { display: none; }
  }
</style>
