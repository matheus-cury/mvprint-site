---
// Botão flutuante do WhatsApp: aparece depois do topo da página.
import Icon from './Icon.astro';
import { getWhatsAppLink } from '../config/site';
---

<aside class="wa-dock" aria-label="Contato rápido">
<a
  href={getWhatsAppLink('default')}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="Fale conosco pelo WhatsApp"
  data-wa-float
>
  <span class="wa-pill" aria-hidden="true">Orçamento no WhatsApp</span>
  <span class="wa-icon"><Icon name="whatsapp" /></span>
</a>
</aside>

<style>
  .wa-float {
    position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 70;
    display: flex; align-items: center; gap: .6rem;
    transform: translate3d(0, 140%, 0);
    transition: transform .8s var(--ease-expo);
  }
  .wa-float.is-visible { transform: none; }
  :global(html:not(.js)) .wa-float { transform: none; }

  .wa-icon {
    position: relative;
    display: grid; place-items: center;
    width: 60px; height: 60px; border-radius: 50%;
    background: var(--color-wa); color: #fff;
    box-shadow: 0 16px 30px -12px rgb(18 140 74 / 65%);
    transition: transform .5s var(--ease-expo), background-color .3s;
  }
  .wa-icon :global(svg) { width: 28px; height: 28px; }
  .wa-icon::before {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    box-shadow: 0 0 0 0 rgb(37 211 102 / 55%);
    animation: wa-pulse 2.6s var(--ease-expo) infinite;
  }
  @keyframes wa-pulse { 0% { box-shadow: 0 0 0 0 rgb(37 211 102 / 55%); } 80%, 100% { box-shadow: 0 0 0 18px rgb(37 211 102 / 0%); } }

  .wa-pill {
    padding: .7rem 1.1rem; border-radius: 999px;
    background: var(--color-ink); color: var(--color-paper);
    font-weight: 600; font-size: .9rem; white-space: nowrap;
    opacity: 0; transform: translate3d(12px, 0, 0);
    transition: opacity .35s, transform .6s var(--ease-expo);
    pointer-events: none;
  }
  @media (hover: hover) {
    .wa-float:hover .wa-pill { opacity: 1; transform: none; }
    .wa-float:hover .wa-icon { transform: scale(1.08) rotate(-8deg); background: var(--color-wa-deep); }
  }
</style>
