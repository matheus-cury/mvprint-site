---
// Mural de clientes: logos "impressos" no papel (multiply), coloridos no hover.
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';

const clients = [
  { name: 'CBF', logo: '/images/logos/cbf.svg', scale: 1.45 },
  { name: 'Cemig', logo: '/images/logos/cemig.svg', scale: 1 },
  { name: 'CSN Mineração', logo: '/images/logos/csn.svg', scale: 1 },
  { name: 'Citroën', logo: '/images/logos/citroen.svg', scale: 1.1 },
  { name: 'Renault', logo: '/images/logos/renault.svg', scale: 1.2 },
  { name: 'Claro', logo: '/images/logos/claro.svg', scale: 1.15 },
  { name: 'Drogarias Pacheco', logo: '/images/logos/drogarias-pacheco.png', scale: 1, width: 74 },
  { name: 'Pague Menos', logo: '/images/logos/pague-menos.svg', scale: 1 },
  { name: 'AeC', logo: '/images/logos/aec.svg', scale: 1 },
  { name: 'Grupo Roma', logo: '/images/logos/grupo-roma.svg', scale: 1 },
  { name: 'Mit Car', logo: '/images/logos/mit-car.png', scale: 1 },
  { name: 'Orcasa Netimóveis', logo: '/images/logos/orcasa.png', scale: 1, width: 84 },
  // JPG quadrado com muita margem: recorta a faixa central.
  { name: 'Grupo Jorlan', logo: '/images/logos/grupo-jorlan.jpg', scale: 1, cover: true },
  { name: 'Pontua X', logo: '/images/logos/pontua-x.jpg', scale: 1, lift: true },
  { name: 'RTI', logo: '/images/logos/RTI.jpg', scale: 1.3, lift: true },
];
---

<section id="clientes" class="sec clients" aria-labelledby="clients-title">
  <div class="wrap">
    <p class="rule"><span><b>Clientes</b></span><Icon name="reg" class="reg-mark" /></p>
    <div class="clients-head">
      <SplitText id="clients-title" class="display t-h2" text="Grandes marcas *já imprimiram com a gente.*" />
      <p class="lede" data-reveal style="--d:.15s">De pequenos negócios a multinacionais: são mais de <strong>200 empresas</strong> atendidas em Belo Horizonte e região.</p>
    </div>

    <ul class="logo-wall" role="list">
      {clients.map((client, index) => (
        <li class="logo-cell" data-reveal="fade" style={`--d:${(index % 5) * 0.06}s`}>
          <img
            src={client.logo}
            alt={client.name}
            class:list={['logo', { 'logo-lift': client.lift, 'logo-cover': client.cover }]}
            style={`--s:${client.scale}${client.width ? `;--w:${client.width}%` : ''}`}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Logo depois do hero: menos respiro no topo. */
  .clients { padding-top: clamp(3.5rem, 6vw, 5.5rem); }
  .clients-head {
    display: grid; gap: 1.25rem; justify-items: start; max-width: 52rem;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  }
  .clients-head strong { font-weight: 600; color: var(--color-ink); }

  .logo-wall {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none; margin: 0; padding: 0;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }
  @media (min-width: 900px) { .logo-wall { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  .logo-cell {
    position: relative;
    display: grid; place-items: center;
    aspect-ratio: 3 / 2;
    align-self: stretch; /* todas as células da linha com a mesma altura: linhas contínuas */
    padding: 1.25rem;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    transition: background-color .4s;
  }
  @media (max-width: 599px) { .logo-cell { padding: .75rem; } }
  .logo-cell::after {
    content: ""; position: absolute; left: 8px; top: 8px; width: 7px; height: 7px;
    border-left: 1px solid var(--line-strong); border-top: 1px solid var(--line-strong);
  }
  .logo {
    width: var(--w, 64%);
    height: calc(clamp(30px, 3.6vw, 52px) * var(--s, 1));
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.1);
    opacity: .78;
    transition: filter .5s, opacity .5s, transform .7s var(--ease-expo);
  }
  .logo-lift { filter: grayscale(1) brightness(1.13) contrast(1.15); }
  .logo-cover { object-fit: cover; }
  @media (hover: hover) {
    .logo-cell:hover { background: var(--color-paper-2); }
    .logo-cell:hover .logo { filter: none; opacity: 1; transform: scale(1.06); }
    .logo-cell:hover .logo-lift { filter: brightness(1.13) contrast(1.1); }
  }

  /* Computador: título e texto lado a lado; três linhas de logos na altura que sobra da tela. */
  @media (min-width: 1024px) {
    .clients-head { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: end; column-gap: clamp(2.5rem, 6vw, 6rem); max-width: none; margin-bottom: clamp(1.5rem, 4.5vh, 3rem); }
    .logo-cell { aspect-ratio: auto; height: clamp(5.5rem, calc((var(--frame) - 12rem) / 3), 10.5rem); padding: clamp(.75rem, 2vh, 1.25rem); }
    .logo { max-height: 100%; }
  }
</style>
