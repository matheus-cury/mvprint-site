---
// Como funciona: quatro passos, do primeiro contato à entrega.
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';

const steps = [
  { icon: 'chat', color: 'var(--color-cyan)', title: 'Conversa', text: 'Você conta a ideia pelo WhatsApp: o que precisa, medidas aproximadas e referências, se tiver.' },
  { icon: 'receipt', color: 'var(--color-magenta)', title: 'Orçamento', text: 'A gente responde em até 24 horas com valores e prazo. Sem compromisso.' },
  { icon: 'printer', color: '#E9A800', title: 'Produção', text: 'Impressão com materiais de alta qualidade, com proteção UV nos adesivos para áreas externas.' },
  { icon: 'truck', color: 'var(--color-ink)', title: 'Instalação ou envio', text: 'Instalamos em Belo Horizonte e região metropolitana e enviamos para todo o Brasil.' },
] as const;
---

<section id="como-funciona" class="sec sec-paper-2 process" aria-labelledby="process-title">
  <div class="wrap">
    <p class="rule"><span><b>Como funciona</b></span><Icon name="reg" class="reg-mark" /></p>
    <SplitText id="process-title" class="display t-h2 process-title" text="Do pedido à instalação, *sem complicação.*" />

    <ol class="steps" role="list">
      {steps.map((step, index) => (
        <li class="step" data-reveal style={`--d:${index * 0.08}s;--c:${step.color}`}>
          <span class="step-top">
            <span class="step-icon"><Icon name={step.icon} /></span>
            <span class="step-num mono">Passo {String(index + 1).padStart(2, '0')}</span>
          </span>
          <h3 class="step-title display">{step.title}</h3>
          <p class="step-text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-title { max-width: 18ch; }
  .steps { list-style: none; margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .step {
    position: relative; display: flex; flex-direction: column; gap: .9rem;
    padding: clamp(1.5rem, 2.5vw, 2rem); border-radius: 20px;
    background: #FBF9F4; box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  .step::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--c); }
  .step-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; }
  .step-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: var(--c); color: #fff; }
  .step-icon :global(svg) { width: 26px; height: 26px; }
  .step-num { font-size: var(--fs-micro); letter-spacing: var(--ls-micro); text-transform: uppercase; color: var(--color-muted); }
  .step-title { font-size: clamp(1.7rem, 2.2vw, 2.1rem); line-height: 1.05; }
  .step-text { color: var(--color-ink-2); }
</style>
