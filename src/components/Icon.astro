---
// Ícones em SVG inline (herdam a cor do texto). Decorativos por padrão.
interface Props {
  name:
    | 'arrow-up-right' | 'arrow-right' | 'arrow-left' | 'arrow-down' | 'whatsapp' | 'phone' | 'mail'
    | 'pin' | 'clock' | 'instagram' | 'facebook' | 'plus' | 'pause' | 'play' | 'star' | 'google'
    | 'close' | 'reg' | 'drag' | 'loupe' | 'chat' | 'receipt' | 'printer' | 'truck';
  class?: string;
  label?: string;
}
const { name, class: className = '', label, ...rest } = Astro.props;
const a11y = { ...rest, ...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }) };
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.6', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'arrow-up-right' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M7 17 17 7M8 7h9v9" /></svg>}
{name === 'arrow-right' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M4 12h16m-6-6 6 6-6 6" /></svg>}
{name === 'arrow-left' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M20 12H4m6-6-6 6 6 6" /></svg>}
{name === 'arrow-down' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M12 4v16m-6-6 6 6 6-6" /></svg>}
{name === 'plus' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M12 5v14M5 12h14" /></svg>}
{name === 'close' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M6 6l12 12M18 6 6 18" /></svg>}
{name === 'pause' && <svg class={className} viewBox="0 0 24 24" fill="currentColor" {...a11y}><rect x="6.5" y="5" width="3.5" height="14" rx="1" /><rect x="14" y="5" width="3.5" height="14" rx="1" /></svg>}
{name === 'play' && <svg class={className} viewBox="0 0 24 24" fill="currentColor" {...a11y}><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>}
{name === 'phone' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M5 4h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 6.3 6.3l1.4-2.2L20 15.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" /></svg>}
{name === 'mail' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>}
{name === 'pin' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg>}
{name === 'clock' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>}
{name === 'drag' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>}
{name === 'loupe' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5M10.5 7.5v6M7.5 10.5h6" /></svg>}
{name === 'chat' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M4 5h16v11H9l-5 4V5Z" /><path d="M8 9.5h8M8 12.5h5" /></svg>}
{name === 'receipt' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z" /><path d="M9 8h6M9 11.5h6M9 15h3" /></svg>}
{name === 'printer' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M7 8V3h10v5" /><rect x="3" y="8" width="18" height="9" rx="2" /><path d="M7 14h10v7H7z" /><path d="M17 11.5h.01" /></svg>}
{name === 'truck' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z" /><circle cx="6.5" cy="17.5" r="2" /><circle cx="17.5" cy="17.5" r="2" /></svg>}
{name === 'reg' && <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" {...a11y}><circle cx="12" cy="12" r="6" /><path d="M12 1v22M1 12h22" /></svg>}
{name === 'star' && <svg class={className} viewBox="0 0 20 20" fill="currentColor" {...a11y}><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 0 0 .95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 0 0-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 0 0-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 0 0-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 0 0 .95-.69l1.07-3.29Z" /></svg>}
{name === 'google' && <svg class={className} viewBox="0 0 24 24" {...a11y}><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09Z" /><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z" /><path fill="#FBBC05" d="M5.84 14.09A6.6 6.6 0 0 1 5.49 12c0-.73.13-1.43.35-2.09V7.07H2.18A11 11 0 0 0 1 12c0 1.78.43 3.45 1.18 4.93l3.66-2.84Z" /><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.6 10.6 0 0 0 12 1 11 11 0 0 0 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z" /></svg>}
{name === 'instagram' && <svg class={className} viewBox="0 0 24 24" {...stroke} {...a11y}><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".6" fill="currentColor" /></svg>}
{name === 'facebook' && <svg class={className} viewBox="0 0 24 24" fill="currentColor" {...a11y}><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.87.25-1.46 1.5-1.46h1.6V4.46A21 21 0 0 0 14.3 4.3c-2.3 0-3.8 1.4-3.8 3.95v2.25H7.9v3h2.6V21h3Z" /></svg>}
{name === 'whatsapp' && <svg class={className} viewBox="0 0 24 24" fill="currentColor" {...a11y}><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88a9.83 9.83 0 0 1 9.88 9.89c0 5.45-4.44 9.88-9.88 9.88Zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z" /></svg>}
