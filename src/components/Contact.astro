---
// Seção de Contato
import { CONTACT, ADDRESS, HOURS, getWhatsAppLink } from '../config/site';
---

<section id="contato" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-[#E91E8C] font-semibold text-sm uppercase tracking-wider">
        Contato
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#1D3557] mt-2 mb-4">
        Fale Conosco
      </h2>
      <p class="text-[#6C757D] text-lg max-w-2xl mx-auto">
        Solicite seu orçamento sem compromisso. Respondemos em até 24 horas!
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Form -->
      <div class="bg-[#F8F9FA] rounded-2xl p-8">
        <form id="contact-form" class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-[#1D3557] mb-2">
              Nome completo
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#E91E8C] focus:ring-2 focus:ring-[#E91E8C]/20 outline-none transition-smooth"
              placeholder="Seu nome"
            />
          </div>

          <div>
            <label for="whatsapp" class="block text-sm font-medium text-[#1D3557] mb-2">
              WhatsApp
            </label>
            <input
              type="tel"
              id="whatsapp"
              name="whatsapp"
              required
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#E91E8C] focus:ring-2 focus:ring-[#E91E8C]/20 outline-none transition-smooth"
              placeholder="(31) 99999-9999"
            />
          </div>

          <div>
            <label for="service" class="block text-sm font-medium text-[#1D3557] mb-2">
              Serviço de interesse
            </label>
            <select
              id="service"
              name="service"
              required
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#E91E8C] focus:ring-2 focus:ring-[#E91E8C]/20 outline-none transition-smooth bg-white"
            >
              <option value="">Selecione um serviço</option>
              <option value="plotagem">Plotagem Veicular</option>
              <option value="comunicacao">Comunicação Visual</option>
              <option value="adesivos">Adesivos e Banners</option>
              <option value="grafica">Gráfica Rápida</option>
              <option value="outro">Outro</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-[#1D3557] mb-2">
              Mensagem
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#E91E8C] focus:ring-2 focus:ring-[#E91E8C]/20 outline-none transition-smooth resize-none"
              placeholder="Descreva seu projeto..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-[#25D366] hover:bg-green-600 text-white px-8 py-4 rounded-xl font-semibold transition-smooth flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Enviar pelo WhatsApp
          </button>
        </form>
      </div>

      <!-- Info + Map -->
      <div class="space-y-8">
        <!-- Contact Info -->
        <div class="bg-[#1D3557] text-white rounded-2xl p-8">
          <h3 class="text-xl font-bold mb-6">Informações de Contato</h3>

          <div class="space-y-4">
            <a
              href={getWhatsAppLink('default')}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-white/10 rounded-xl hover:bg-white/20 transition-smooth"
            >
              <div class="w-12 h-12 bg-[#25D366] rounded-full flex items-center justify-center">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">{CONTACT.whatsapp.display}</div>
                <div class="text-sm text-gray-300">WhatsApp</div>
              </div>
            </a>

            <a
              href={`tel:${CONTACT.phone.number}`}
              class="flex items-center gap-4 p-4 bg-white/10 rounded-xl hover:bg-white/20 transition-smooth"
            >
              <div class="w-12 h-12 bg-[#E91E8C] rounded-full flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">{CONTACT.phone.display}</div>
                <div class="text-sm text-gray-300">Telefone fixo</div>
              </div>
            </a>

            <a
              href={`mailto:${CONTACT.email}`}
              class="flex items-center gap-4 p-4 bg-white/10 rounded-xl hover:bg-white/20 transition-smooth"
            >
              <div class="w-12 h-12 bg-[#00B4D8] rounded-full flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">{CONTACT.email}</div>
                <div class="text-sm text-gray-300">E-mail</div>
              </div>
            </a>

            <div class="flex items-center gap-4 p-4 bg-white/10 rounded-xl">
              <div class="w-12 h-12 bg-[#F4A261] rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold">{HOURS.display}</div>
                <div class="text-sm text-gray-300">Horário de funcionamento</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="rounded-2xl overflow-hidden shadow-lg h-64">
          <iframe
            src="https://maps.google.com/maps?q=Rua+Bernardes+Carvalho,+21+-+Santa+Terezinha,+Belo+Horizonte+-+MG,+31360-130&t=&z=16&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localização MV Print - Rua Bernardes Carvalho, 21 - Santa Terezinha, BH"
          ></iframe>
        </div>

        <!-- Address -->
        <div class="text-center text-[#6C757D]">
          <p class="font-semibold text-[#1D3557]">{ADDRESS.street}</p>
          <p>{ADDRESS.neighborhood} - {ADDRESS.city}/{ADDRESS.state}</p>
          <p>CEP: {ADDRESS.zip}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Form handler - abre WhatsApp com os dados preenchidos
  const form = document.getElementById('contact-form');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const formData = new FormData(form as HTMLFormElement);
    const name = formData.get('name');
    const whatsapp = formData.get('whatsapp');
    const service = formData.get('service');
    const message = formData.get('message');

    const serviceNames: Record<string, string> = {
      'plotagem': 'Plotagem Veicular',
      'comunicacao': 'Comunicação Visual',
      'adesivos': 'Adesivos e Banners',
      'grafica': 'Gráfica Rápida',
      'outro': 'Outro'
    };

    const serviceName = serviceNames[service as string] || service;

    let text = `Olá! Vim pelo site da MV Print.\n\n`;
    text += `*Nome:* ${name}\n`;
    text += `*WhatsApp:* ${whatsapp}\n`;
    text += `*Serviço:* ${serviceName}\n`;
    if (message) {
      text += `*Mensagem:* ${message}`;
    }

    const whatsappUrl = `https://wa.me/5531973024426?text=${encodeURIComponent(text)}`;
    window.open(whatsappUrl, '_blank');
  });
</script>
