---
// Contato: formulário que abre o WhatsApp com a mensagem pronta.
// Mantém id="contact-form" e os campos name/whatsapp/service/message.
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { CONTACT, ADDRESS, HOURS, SOCIAL, getWhatsAppLink } from '../config/site';

const services = [
  { value: 'plotagem', label: 'Plotagem veicular' },
  { value: 'comunicacao', label: 'Fachadas e sinalização' },
  { value: 'ambientes', label: 'Ambientes e vitrines' },
  { value: 'tapumes', label: 'Tapumes e lonas' },
  { value: 'adesivos', label: 'Adesivos e etiquetas' },
  { value: 'grafica', label: 'Gráfica rápida' },
  { value: 'outro', label: 'Outro' },
];

const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ADDRESS.full)}`;
---

<section id="contato" class="sec contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="rule"><span><b>Contato</b></span><Icon name="reg" class="reg-mark" /></p>
    <SplitText id="contact-title" class="display t-h2 contact-title" text="Bora imprimir *a sua ideia?*" />

    <div class="contact-grid">
      <div class="form-card" data-reveal>
        <div class="form-head">
          <p class="eyebrow">Orçamento sem compromisso</p>
          <p class="form-sub">Preencha e continue no WhatsApp. Respondemos em até 24 horas.</p>
        </div>
        <form id="contact-form" class="form">
          <div class="field">
            <input type="text" id="name" name="name" autocomplete="name" maxlength="100" required placeholder=" " />
            <label for="name">Seu nome</label>
          </div>
          <fieldset class="chips">
            <legend>O que você precisa?</legend>
            <div class="chips-list">
              {services.map((service, index) => (
                <label class="chip">
                  <input type="radio" name="service" value={service.value} required={index === 0} />
                  <span>{service.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="field field-area">
            <textarea id="message" name="message" maxlength="2000" rows="4" placeholder=" "></textarea>
            <label for="message">Conte do projeto: medidas, prazo, referências</label>
          </div>
          <div class="form-actions">
          <button type="submit" class="btn btn-wa btn-lg form-submit" data-magnetic="0.15">
            <span class="roll"><span>Continuar no WhatsApp</span><span aria-hidden="true">Continuar no WhatsApp</span></span>
            <span class="btn-icon" data-icon="whatsapp"><Icon name="whatsapp" /></span>
          </button>
          <p class="form-note">A conversa abre com os dados preenchidos. Você confere e envia a mensagem no WhatsApp.</p>
          </div>
        </form>
        <noscript><p class="form-note"><a href={getWhatsAppLink('default')} class="u-link is-static">Pedir orçamento direto no WhatsApp</a></p></noscript>
      </div>

      <div class="contact-info">
        <ul class="channels" role="list">
          <li data-reveal style="--d:.05s">
            <a href={getWhatsAppLink('default')} target="_blank" rel="noopener noreferrer" class="channel">
              <span class="channel-label mono"><i class="dot dot-live"></i>WhatsApp</span>
              <span class="channel-value">{CONTACT.whatsapp.display}</span>
              <Icon name="arrow-up-right" class="channel-arrow" />
            </a>
          </li>
          <li data-reveal style="--d:.1s">
            <a href={`tel:${CONTACT.phone.number}`} class="channel">
              <span class="channel-label mono">Telefone</span>
              <span class="channel-value">{CONTACT.phone.display}</span>
              <Icon name="arrow-up-right" class="channel-arrow" />
            </a>
          </li>
          <li data-reveal style="--d:.15s">
            <a href={`mailto:${CONTACT.email}`} class="channel">
              <span class="channel-label mono">E-mail</span>
              <span class="channel-value channel-email">{CONTACT.email}</span>
              <Icon name="arrow-up-right" class="channel-arrow" />
            </a>
          </li>
          <li data-reveal style="--d:.2s">
            <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="channel">
              <span class="channel-label mono">Instagram</span>
              <span class="channel-value">@mvprintbh</span>
              <Icon name="arrow-up-right" class="channel-arrow" />
            </a>
          </li>
        </ul>

        <div class="place" data-reveal style="--d:.1s">
          <div class="map">
            <iframe
              src="https://maps.google.com/maps?q=Rua+Bernardes+Carvalho,+21+-+Santa+Terezinha,+Belo+Horizonte+-+MG,+31360-130&t=&z=16&ie=UTF8&iwloc=&output=embed"
              width="600"
              height="360"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa: MV Print na Rua Bernardes Carvalho, 21, Santa Terezinha, Belo Horizonte"
            ></iframe>
          </div>
          <div class="place-info">
            <p class="place-row"><Icon name="pin" /><span><strong>{ADDRESS.street}</strong><br />{ADDRESS.neighborhood}, {ADDRESS.city}/{ADDRESS.state} · CEP {ADDRESS.zip}</span></p>
            <p class="place-row"><Icon name="clock" /><span>{HOURS.display}</span></p>
            <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="u-link is-static place-link tap">Abrir no Google Maps</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid; gap: 3rem clamp(3rem, 6vw, 6rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 1024px) { .contact-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }

  .form-card {
    position: relative;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    background: #FBF9F4;
    box-shadow: 0 1px 0 rgb(22 18 14 / 6%), 0 40px 70px -45px rgb(22 18 14 / 45%);
  }
  .form-card::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 6px;
    background: linear-gradient(90deg, var(--color-cyan) 0 25%, var(--color-magenta) 25% 50%, var(--color-yellow) 50% 75%, var(--color-ink) 75%);
  }
  .form-head { display: grid; gap: .4rem; margin-bottom: 1.8rem; }
  .form-head .eyebrow { color: var(--title-accent); }
  .form-sub { color: var(--color-muted); }

  .form { display: grid; gap: 1.3rem; }

  .field { position: relative; }
  .field input, .field textarea {
    width: 100%;
    padding: 1.45rem 0 .6rem;
    border: 0; border-bottom: 1px solid var(--line-strong);
    background: transparent;
    color: var(--color-ink);
    font-size: 1.1rem;
    outline: none;
    border-radius: 0;
    transition: border-color .3s;
  }
  .field textarea { resize: vertical; min-height: 7.5rem; }
  .field label {
    position: absolute; left: 0; top: 1.35rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    transform-origin: left top;
    transition: transform .45s var(--ease-expo), color .3s;
    pointer-events: none;
  }
  .field input:focus + label, .field input:not(:placeholder-shown) + label,
  .field textarea:focus + label, .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-1.2rem) scale(.72);
    color: var(--color-ink-2);
  }
  .field::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--color-magenta);
    transform: scaleX(0); transform-origin: left;
    transition: transform .6s var(--ease-expo);
  }
  .field:focus-within::after { transform: scaleX(1); }
  .field input:user-invalid { border-color: var(--color-magenta-deep); }

  .chips { border: 0; margin: .4rem 0 0; padding: 0; min-width: 0; }
  .chips legend { font-size: .95rem; color: var(--color-muted); margin-bottom: .75rem; }
  .chips-list { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: .55rem 1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: .92rem; font-weight: 500;
    transition: background-color .3s, color .3s, box-shadow .3s;
  }
  .chip:hover span { box-shadow: inset 0 0 0 1px var(--color-ink); }
  .chip input:checked + span { background: var(--color-ink); color: var(--color-paper); box-shadow: none; }
  .chip input:focus-visible + span { outline: 2px solid var(--color-magenta); outline-offset: 3px; }

  .form-actions { display: grid; gap: 1.3rem; justify-items: start; }
  .form-submit { justify-self: start; margin-top: .6rem; }
  .form-note { font-size: .88rem; color: var(--color-muted); }

  /* Canais */
  .channels { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .channel {
    display: grid; grid-template-columns: 7.5rem minmax(0, 1fr) auto; align-items: center; gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line-strong);
    transition: color .3s;
  }
  .channel-label { display: inline-flex; align-items: center; gap: .5rem; font-size: var(--fs-micro); letter-spacing: var(--ls-micro); text-transform: uppercase; color: var(--color-muted); }
  .channel-value { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.35rem, 2.1vw, 1.9rem); line-height: 1.1; letter-spacing: -0.025em; transition: transform .6s var(--ease-expo); overflow-wrap: anywhere; }
  .channel-email { font-size: clamp(1.1rem, 1.6vw, 1.5rem); }
  .channel :global(.channel-arrow) { width: 1.4rem; height: 1.4rem; opacity: .35; transition: transform .6s var(--ease-expo), opacity .3s; }
  @media (hover: hover) {
    .channel:hover { color: var(--title-accent); }
    .channel:hover .channel-value { transform: translateX(.5rem); }
    .channel:hover :global(.channel-arrow) { opacity: 1; transform: rotate(45deg); }
  }
  @media (max-width: 520px) {
    .channel { grid-template-columns: minmax(0, 1fr) auto; }
    .channel-label { grid-column: 1 / -1; }
  }

  .place { margin-top: 2.2rem; display: grid; gap: 1.2rem; }
  .map { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-paper-3); }
  .map iframe {
    width: 100%; height: 100%;
    filter: grayscale(1) sepia(.35) contrast(1.05) brightness(1.02);
    mix-blend-mode: multiply;
    transition: filter .6s;
  }
  .map:hover iframe { filter: none; mix-blend-mode: normal; }
  .place-info { display: grid; gap: .7rem; }
  .place-row { display: flex; gap: .7rem; color: var(--color-ink-2); }
  .place-row :global(svg) { width: 1.2rem; height: 1.2rem; flex: none; margin-top: .2rem; color: var(--title-accent); }
  .place-row strong { font-weight: 600; color: var(--color-ink); }
  .place-link { justify-self: start; font-weight: 600; }

  /* Computador: formulário e canais compactos para a seção caber numa tela. */
  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); margin-top: clamp(1.5rem, 4vh, 3rem); }
    .form-card { padding: clamp(1.25rem, 3vh, 2.25rem) clamp(1.5rem, 2.5vw, 2.5rem); }
    .form-head { margin-bottom: clamp(.6rem, 2vh, 1.4rem); }
    .form { gap: clamp(.6rem, 1.6vh, 1.1rem); }
    .form-actions { display: flex; align-items: center; gap: 1.25rem; }
    .form-note { flex: 1; min-width: 0; }
    .field input, .field textarea { padding-top: 1.25rem; font-size: 1.05rem; }
    .field label { top: 1.15rem; }
    .field textarea { height: clamp(4.5rem, 11vh, 7rem); min-height: 0; }
    .chips legend { margin-bottom: .5rem; }
    .chip span { min-height: 38px; padding: .4rem .9rem; font-size: .9rem; }
    .form-submit { margin-top: 0; flex: none; min-height: 3.5rem; font-size: 1rem; padding-left: 1.5rem; }
    .form-submit :global(.btn-icon) { width: 2.6rem; height: 2.6rem; }
    .form-note { font-size: .8rem; }
    .channel { padding: clamp(.5rem, 1.5vh, 1rem) 0; }
    .channel-value { font-size: clamp(1.2rem, 1.7vw, 1.6rem); }
    .channel-email { font-size: clamp(1rem, 1.35vw, 1.3rem); }
    .place { margin-top: clamp(1rem, 3vh, 2rem); gap: .8rem; }
    .map { aspect-ratio: auto; height: clamp(6rem, 13vh, 12rem); }
    .place-info { gap: .45rem; }
  }

  @media (min-width: 1024px) and (max-height: 700px) {
    .form-head .form-sub { display: none; }
    .form-card { padding-block: 1rem; }
    .form-head { margin-bottom: .45rem; }
    .field textarea { height: 4rem; }
    .channel { padding-block: .35rem; }
    .place { margin-top: .9rem; }
    .chips legend { margin-bottom: .35rem; }
    .map { height: 5.5rem; }
  }
</style>
