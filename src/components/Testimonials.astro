---
// Avaliações reais do Google em cartões.
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';

const googleReviewsUrl = 'https://www.google.com/search?kgmid=/g/11h_6s5l59';

const reviews = [
  { name: 'Joana Darc T. Fernandes', source: 'Google', text: 'Meu adesivo ficou ótimo e entregue dentro do prazo! Preço justo e qualidade. Vou continuar cliente e indico!' },
  { name: 'Edmara', source: 'Google · Local Guide', text: 'Vi num anúncio, não conhecia o trabalho e me surpreendi. Plotaram meu carro de trabalho e ficou muito bom.' },
  { name: 'Wagner Silva', source: 'Google', text: 'Ótimo atendimento domiciliar, rapidez, excelente profissional em plotagem e envelopamento.' },
  { name: 'Jorge Diniz', source: 'Google', text: 'Tudo certinho. Pessoal da empresa foi nota 10. O serviço ficou muito bom.' },
  { name: 'Paulino Gregório', source: 'Google', text: 'Eu e minha esposa gostamos bastante, ficamos satisfeitos. Vocês estão de parabéns, ficou top!' },
  { name: 'Ricardo Mendes', source: 'Google', text: 'Serviço excelente, ótimo atendimento e cumpre com o prazo prometido.' },
];
const avatarColors = ['var(--color-cyan)', 'var(--color-magenta)', 'var(--color-ink)'];
---

<section id="depoimentos" class="sec sec-paper-2 reviews" aria-labelledby="reviews-title">
  <div class="wrap">
    <p class="rule"><span><b>Avaliações</b></span><Icon name="reg" class="reg-mark" /></p>

    <div class="reviews-head">
      <SplitText id="reviews-title" class="display t-h2" text="Quem imprime com a gente, *recomenda.*" />
      <a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="rating" data-reveal style="--d:.15s">
        <Icon name="google" class="rating-g" />
        <span class="rating-score display">4,4</span>
        <span class="rating-info">
          <span class="stars" aria-hidden="true">{[0, 1, 2, 3].map(() => <Icon name="star" />)}<span class="star-part"></span></span>
          <span class="rating-count">28 avaliações no Google</span>
        </span>
        <Icon name="arrow-up-right" class="rating-arrow" />
      </a>
    </div>

    <ul class="review-grid" role="list">
      {reviews.map((review, index) => (
        <li class="review" data-reveal style={`--d:${(index % 3) * 0.08}s`}>
          <span class="stars" aria-label="5 estrelas" role="img">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
          <blockquote class="review-text"><p>“{review.text}”</p></blockquote>
          <p class="review-by">
            <span class="review-avatar" style={`background:${avatarColors[index % 3]}`} aria-hidden="true">{review.name.charAt(0)}</span>
            <span><b>{review.name}</b><small>{review.source}</small></span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews-head {
    display: grid; gap: 1.25rem; justify-items: start; max-width: 52rem;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  }

  .rating {
    display: inline-flex; align-items: center; gap: 1rem; justify-self: start;
    padding: 1rem 1.4rem; border-radius: 18px;
    background: #FBF9F4; box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow .3s, transform .5s var(--ease-expo);
  }
  .rating:hover { box-shadow: inset 0 0 0 1px var(--line-strong); transform: translateY(-2px); }
  .rating :global(.rating-g) { width: 2rem; height: 2rem; }
  .rating-score { font-size: 2.3rem; line-height: 1; }
  .rating-info { display: grid; gap: .3rem; }
  .rating-count { font-size: .9rem; color: var(--color-ink-2); }
  .rating :global(.rating-arrow) { width: 1.1rem; height: 1.1rem; opacity: .5; }
  @media (max-width: 719px) {
    .rating { justify-self: stretch; }
    .rating :global(.rating-arrow) { margin-left: auto; }
  }

  .stars { display: inline-flex; gap: .15rem; color: #E9A800; }
  .stars :global(svg) { width: 1.1rem; height: 1.1rem; }
  .star-part {
    display: inline-block; width: 1.1rem; height: 1.1rem;
    background: linear-gradient(90deg, #E9A800 40%, var(--color-paper-3) 40%);
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 0 0 .95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 0 0-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 0 0-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 0 0-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 0 0 .95-.69l1.07-3.29Z'/></svg>") center / contain no-repeat;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path d='M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 0 0 .95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 0 0-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 0 0-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 0 0-.36-1.12L2.98 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 0 0 .95-.69l1.07-3.29Z'/></svg>") center / contain no-repeat;
  }

  .review-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .review-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .review-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .review {
    display: flex; flex-direction: column; gap: 1.1rem;
    padding: clamp(1.5rem, 2.5vw, 2rem); border-radius: 20px;
    background: #FBF9F4; box-shadow: inset 0 0 0 1px var(--line);
  }
  .review-text { margin: 0; flex: 1; font-size: 1.08rem; line-height: 1.55; color: var(--color-ink); }
  .review-by { display: flex; align-items: center; gap: .8rem; }
  .review-avatar {
    display: grid; place-items: center; flex: none; width: 42px; height: 42px; border-radius: 50%;
    color: #fff; font-weight: 600;
  }
  .review-by b { display: block; font-weight: 600; font-size: .95rem; }
  .review-by small { display: block; font-size: .8rem; color: var(--color-muted); }

  /* Computador: nota do Google ao lado do título e cartões mais enxutos. */
  @media (min-width: 1024px) {
    .reviews-head { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 3rem; max-width: none; margin-bottom: clamp(1.5rem, 4.5vh, 3rem); }
    .rating { justify-self: end; }
    .review-grid { gap: clamp(.75rem, 2vh, 1.25rem); }
    .review { gap: .8rem; padding: clamp(1.1rem, 2.6vh, 1.75rem) clamp(1.25rem, 2vw, 1.75rem); }
  }

  @media (min-width: 1024px) and (max-height: 700px) {
    .review { gap: .55rem; padding-block: .9rem; }
    .review-text { font-size: 1rem; line-height: 1.5; }
  }
</style>
