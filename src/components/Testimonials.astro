---
// Seção de Depoimentos - Avaliações reais do Google
const testimonials = [
  {
    name: "Jorge Diniz",
    source: "Google",
    text: "Tudo certinho. Pessoal da empresa foi nota 10. O serviço ficou muito bom.",
    rating: 5
  },
  {
    name: "Joana Darc T. Fernandes",
    source: "Google",
    text: "Meu adesivo ficou ótimo e entregue dentro do prazo! Preço justo e qualidade. Vou continuar cliente e indico!",
    rating: 5
  },
  {
    name: "Edmara",
    source: "Google · Local Guide",
    text: "Vi num anúncio, não conhecia o trabalho e me surpreendi. Plotaram meu carro de trabalho e ficou muito bom.",
    rating: 5
  },
  {
    name: "King Empire",
    source: "Google",
    text: "Serviço excelente, ótimo atendimento e cumpre com o prazo prometido.",
    rating: 5
  },
  {
    name: "Paulino Gregório",
    source: "Google",
    text: "Eu e minha esposa gostamos bastante, ficamos satisfeitos. Vocês estão de parabéns, ficou top!",
    rating: 5
  },
  {
    name: "Wagner Silva",
    source: "Google",
    text: "Ótimo atendimento domiciliar, rapidez, excelente profissional em plotagem e envelopamento.",
    rating: 5
  }
];
---

<section id="depoimentos" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-[#E91E8C] font-semibold text-sm uppercase tracking-wider">
        Avaliações
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#1D3557] mt-2 mb-4">
        O que nossos clientes dizem
      </h2>
      <p class="text-[#6C757D] text-lg max-w-2xl mx-auto flex items-center justify-center gap-2">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Avaliações verificadas do Google
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-[#F8F9FA] rounded-2xl p-8 relative">
          <!-- Quote icon -->
          <div class="absolute top-6 right-6 text-[#E91E8C]/20">
            <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>

          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-5 h-5 text-[#F4A261]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Text -->
          <p class="text-[#1D3557] mb-6 leading-relaxed">
            "{testimonial.text}"
          </p>

          <!-- Author -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gradient-to-br from-[#E91E8C] to-[#00B4D8] rounded-full flex items-center justify-center text-white font-bold text-lg">
              {testimonial.name.charAt(0)}
            </div>
            <div>
              <p class="font-semibold text-[#1D3557]">{testimonial.name}</p>
              <p class="text-sm text-[#6C757D] flex items-center gap-1">
                <svg class="w-4 h-4" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                {testimonial.source}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust badges -->
    <div class="mt-16 flex flex-wrap justify-center items-center gap-8 text-[#6C757D]">
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-medium">6+ anos de mercado</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-medium">1000+ projetos entregues</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-medium">Atendimento em todo Brasil</span>
      </div>
    </div>
  </div>
</section>
