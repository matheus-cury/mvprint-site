---
// Seção de Depoimentos - Carrossel responsivo
const googleReviewsUrl = "https://www.google.com/maps/search/MV+Print+BH+Grafica+Comunicacao+Visual/@-19.8876,-43.9541,17z";

const testimonials = [
  {
    name: "Jorge Diniz",
    source: "Google",
    text: "Tudo certinho. Pessoal da empresa foi nota 10. O serviço ficou muito bom.",
    rating: 5
  },
  {
    name: "Joana Darc T. Fernandes",
    source: "Google",
    text: "Meu adesivo ficou ótimo e entregue dentro do prazo! Preço justo e qualidade. Vou continuar cliente e indico!",
    rating: 5
  },
  {
    name: "Edmara",
    source: "Google · Local Guide",
    text: "Vi num anúncio, não conhecia o trabalho e me surpreendi. Plotaram meu carro de trabalho e ficou muito bom.",
    rating: 5
  },
  {
    name: "Ricardo Mendes",
    source: "Google",
    text: "Serviço excelente, ótimo atendimento e cumpre com o prazo prometido.",
    rating: 5
  },
  {
    name: "Paulino Gregório",
    source: "Google",
    text: "Eu e minha esposa gostamos bastante, ficamos satisfeitos. Vocês estão de parabéns, ficou top!",
    rating: 5
  },
  {
    name: "Wagner Silva",
    source: "Google",
    text: "Ótimo atendimento domiciliar, rapidez, excelente profissional em plotagem e envelopamento.",
    rating: 5
  },
  {
    name: "Lucas Cury",
    source: "Google",
    text: "Serviços de qualidade e ótimos preços. Recomendo.",
    rating: 5
  },
  {
    name: "Claudia",
    source: "Google",
    text: "Atendimento rápido e de qualidade.",
    rating: 5
  },
  {
    name: "Rodrigo Quintino",
    source: "Google · Local Guide",
    text: "Ótimo atendimento. Serviço impecável e dentro do prazo.",
    rating: 5
  }
];

// Agrupa em sets de 3 para o carrossel desktop
const testimonialSets = [];
for (let i = 0; i < testimonials.length; i += 3) {
  testimonialSets.push(testimonials.slice(i, i + 3));
}
---

<section id="depoimentos" class="py-20 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="text-[#E91E8C] font-semibold text-sm uppercase tracking-wider">
        Avaliações
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#1D3557] mt-2 mb-4">
        O que nossos clientes dizem
      </h2>
      <a
        href={googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 text-lg hover:opacity-80 transition-opacity cursor-pointer"
      >
        <div class="flex gap-0.5">
          {[1,2,3,4].map(() => (
            <svg class="w-6 h-6 text-[#F4A261]" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
          <svg class="w-6 h-6 text-[#F4A261]" fill="currentColor" viewBox="0 0 20 20">
            <defs>
              <linearGradient id="half-star">
                <stop offset="40%" stop-color="#F4A261"/>
                <stop offset="40%" stop-color="#E5E7EB"/>
              </linearGradient>
            </defs>
            <path fill="url(#half-star)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        </div>
        <span class="font-bold text-[#1D3557]">4,4</span>
        <span class="text-[#6C757D]">·</span>
        <span class="text-[#6C757D]">28 avaliações no</span>
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
      </a>
    </div>

    <!-- Carrossel Container -->
    <div class="relative">
      <!-- Cards Container -->
      <div id="testimonials-carousel" class="overflow-hidden">
        <div id="testimonials-track" class="flex transition-transform duration-500 ease-in-out">
          {testimonialSets.map((set, setIndex) => (
            <div class="testimonial-set flex-shrink-0 w-full grid grid-cols-1 md:grid-cols-3 gap-6 px-1" data-set={setIndex}>
              {set.map((testimonial) => (
                <div class="bg-[#F8F9FA] rounded-2xl p-6 relative h-full">
                  <!-- Quote icon -->
                  <div class="absolute top-4 right-4 text-[#E91E8C]/20">
                    <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                    </svg>
                  </div>

                  <!-- Stars -->
                  <div class="flex gap-1 mb-3">
                    {Array.from({ length: testimonial.rating }).map(() => (
                      <svg class="w-5 h-5 text-[#F4A261]" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    ))}
                  </div>

                  <!-- Text -->
                  <p class="text-[#1D3557] mb-4 leading-relaxed">
                    "{testimonial.text}"
                  </p>

                  <!-- Author -->
                  <div class="flex items-center gap-3 mt-auto">
                    <div class="w-10 h-10 bg-gradient-to-br from-[#E91E8C] to-[#00B4D8] rounded-full flex items-center justify-center text-white font-bold">
                      {testimonial.name.charAt(0)}
                    </div>
                    <div>
                      <p class="font-semibold text-[#1D3557] text-sm">{testimonial.name}</p>
                      <p class="text-xs text-[#6C757D] flex items-center gap-1">
                        <svg class="w-3 h-3" viewBox="0 0 24 24">
                          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        {testimonial.source}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- Dots Navigation -->
      <div class="flex justify-center gap-2 mt-8">
        {testimonialSets.map((_, index) => (
          <button
            class="carousel-dot w-3 h-3 rounded-full bg-gray-300 hover:bg-[#E91E8C] transition-colors duration-300"
            data-index={index}
            aria-label={`Ver avaliações ${index * 3 + 1} a ${Math.min((index + 1) * 3, testimonials.length)}`}
          ></button>
        ))}
      </div>
    </div>

    <!-- Trust badges -->
    <div class="mt-12 flex flex-wrap justify-center items-center gap-8 text-[#6C757D]">
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-medium">6+ anos de mercado</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-medium">1000+ projetos entregues</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-medium">Atendimento em todo Brasil</span>
      </div>
    </div>

    <!-- Botão Ver todas no Google -->
    <div class="mt-8 text-center">
      <a
        href={googleReviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-white border-2 border-[#1D3557] text-[#1D3557] rounded-full font-semibold hover:bg-[#1D3557] hover:text-white transition-all duration-300"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Ver todas as avaliações no Google
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('testimonials-track');
    const dots = document.querySelectorAll('.carousel-dot');
    const totalSets = dots.length;
    let currentIndex = 0;
    let autoPlayInterval: ReturnType<typeof setInterval>;
    let isPaused = false;

    function goToSlide(index: number) {
      currentIndex = index;
      if (track) {
        track.style.transform = `translateX(-${index * 100}%)`;
      }
      updateDots();
    }

    function updateDots() {
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove('bg-gray-300');
          dot.classList.add('bg-[#E91E8C]');
        } else {
          dot.classList.remove('bg-[#E91E8C]');
          dot.classList.add('bg-gray-300');
        }
      });
    }

    function nextSlide() {
      const next = (currentIndex + 1) % totalSets;
      goToSlide(next);
    }

    function startAutoPlay() {
      autoPlayInterval = setInterval(() => {
        if (!isPaused) {
          nextSlide();
        }
      }, 5000);
    }

    // Click nos dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToSlide(index);
      });
    });

    // Pausa no hover
    const carousel = document.getElementById('testimonials-carousel');
    if (carousel) {
      carousel.addEventListener('mouseenter', () => {
        isPaused = true;
      });
      carousel.addEventListener('mouseleave', () => {
        isPaused = false;
      });
    }

    // Navegação por teclado
    document.addEventListener('keydown', (e) => {
      // Só navega se o carrossel estiver visível na tela
      const carouselRect = carousel?.getBoundingClientRect();
      if (!carouselRect) return;

      const isVisible = carouselRect.top < window.innerHeight && carouselRect.bottom > 0;
      if (!isVisible) return;

      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const prev = currentIndex > 0 ? currentIndex - 1 : totalSets - 1;
        goToSlide(prev);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextSlide();
      }
    });

    // Inicializa
    updateDots();
    startAutoPlay();
  });
</script>

<style>
  /* Respeita preferência de movimento reduzido */
  @media (prefers-reduced-motion: reduce) {
    #testimonials-track {
      transition: none;
    }
  }
</style>
