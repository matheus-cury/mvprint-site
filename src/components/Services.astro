---
// Seção de Serviços
import { getWhatsAppLink } from '../config/site';

const services = [
  {
    icon: "car",
    title: "Plotagem Veicular",
    description: "Transforme sua frota em mídia móvel",
    items: ["Envelopamento completo", "Plotagem de frotas", "Personalização de veículos", "Caminhões e utilitários"],
    image: "/images/portfolio/veiculos-8982d6d7-b525-4103-8dad-a33e1b6342d8",
    whatsappMsg: "Olá! Gostaria de um orçamento para plotagem veicular."
  },
  {
    icon: "building",
    title: "Comunicação Visual",
    description: "Destaque sua marca no ponto de venda",
    items: ["Fachadas e letreiros", "Placas e sinalização", "Adesivação de ambientes", "Vitrines e tapumes"],
    image: "/images/portfolio/ambientes-689498ae-10a6-4a37-95fb-307ec35bf8b4",
    whatsappMsg: "Olá! Gostaria de um orçamento para comunicação visual."
  },
  {
    icon: "image",
    title: "Adesivos & Banners",
    description: "Materiais promocionais de alto impacto",
    items: ["Adesivos personalizados", "Banners e backdrops", "Faixas e lonas", "Material imobiliário"],
    image: "/images/portfolio/tapumes-11e2f421-a874-4c97-b166-2dac2c960d24",
    whatsappMsg: "Olá! Gostaria de um orçamento para adesivos/banners."
  },
  {
    icon: "printer",
    title: "Gráfica Rápida",
    description: "Impressos com qualidade e agilidade",
    items: ["Cartões de visita", "Panfletos e folders", "Blocos e formulários", "Encadernação"],
    image: "/images/portfolio/blocos-446d5a03-dbde-463f-9cb0-909077d3be96",
    whatsappMsg: "Olá! Gostaria de um orçamento para gráfica rápida."
  }
];
---

<section id="servicos" class="py-20 bg-[#F8F9FA]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-[#E91E8C] font-semibold text-sm uppercase tracking-wider">
        Nossos Serviços
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#1D3557] mt-2 mb-4">
        Soluções completas para sua marca
      </h2>
      <p class="text-[#6C757D] text-lg max-w-2xl mx-auto">
        Do cartão de visita ao envelopamento completo de frotas, temos a solução ideal para destacar sua empresa.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {services.map((service) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg card-hover transition-smooth group">
          <!-- Image -->
          <div class="relative h-48 overflow-hidden">
            <picture>
              <source srcset={`${service.image}.webp`} type="image/webp" />
              <img
                src={`${service.image}.jpg`}
                alt={`Serviço de ${service.title} - MV Print BH`}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
                width="400"
                height="192"
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <!-- Icon -->
            <div class="absolute bottom-4 left-4 w-12 h-12 bg-[#E91E8C] rounded-xl flex items-center justify-center">
              {service.icon === "car" && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 5h8m-4 5v-5m-8 5h16a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0017 8h-2V6a1 1 0 00-1-1H6a1 1 0 00-1 1v10a1 1 0 001 1z"/>
                </svg>
              )}
              {service.icon === "building" && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              )}
              {service.icon === "image" && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              )}
              {service.icon === "printer" && (
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                </svg>
              )}
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="text-xl font-bold text-[#1D3557] mb-2">{service.title}</h3>
            <p class="text-[#6C757D] mb-4">{service.description}</p>
            <ul class="space-y-2 mb-4">
              {service.items.map((item) => (
                <li class="flex items-center gap-2 text-sm text-[#1D3557]">
                  <svg class="w-4 h-4 text-[#E91E8C] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <!-- CTA Contextual -->
            <a
              href={getWhatsAppLink(service.whatsappMsg)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[#25D366] hover:text-[#20bd5a] font-semibold text-sm transition-smooth"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Solicitar orçamento
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a
        href={getWhatsAppLink('default')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#E91E8C] hover:bg-[#C4177A] text-white px-8 py-4 rounded-full font-semibold transition-smooth"
      >
        Solicitar Orçamento
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
