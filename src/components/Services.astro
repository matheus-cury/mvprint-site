---
import Button from './Button.astro';
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { getWhatsAppLink } from '../config/site';
import { optimized } from '../lib/images';

const services = [
  {
    title: 'Plotagem veicular',
    description: 'Carros, vans, caminhões e frotas inteiras viram mídia rodando pela cidade.',
    tags: ['Envelopamento', 'Frotas', 'Para-brisa', 'Caminhões'],
    image: 'carros-225cc5a4-81cd-472c-bd4a-4c146fa9d1c2',
    alt: 'Doblò da Super Benefícios plotado pela MV Print',
    slug: 'veiculos',
    message: 'plotagem',
  },
  {
    title: 'Fachadas & sinalização',
    description: 'Placas, letreiros, totens e sinalização para a sua empresa ser encontrada e lembrada.',
    tags: ['Fachadas', 'Placas em PVC', 'Totens', 'Sinalização'],
    image: 'placas-lonas-81114010-4ab1-48ec-a96c-8af2eec87f98',
    alt: 'Placa de estacionamento para clientes da Minas France',
    slug: 'placas-lonas',
    message: 'comunicacao',
  },
  {
    title: 'Ambientes & vitrines',
    description: 'Paredes, escritórios e vitrines adesivados com a identidade da marca.',
    tags: ['Adesivo de parede', 'Vitrines', 'Jateado', 'Recorte'],
    image: 'ambientes-99d64249-05b6-4a92-8123-86aa5aae81f7',
    alt: 'Parede do Ecad adesivada com ilustração de trompete',
    slug: 'ambientes',
    message: 'Olá! Gostaria de um orçamento para adesivação de ambiente ou vitrine.',
  },
  {
    title: 'Tapumes & grandes formatos',
    description: 'Tapumes, lonas, faixas e backdrops que transformam obra e evento em anúncio.',
    tags: ['Tapumes', 'Lonas', 'Backdrops', 'Banners'],
    image: 'tapumes-cdf90ef0-bc09-4604-b007-e1b0e1446ca1',
    alt: 'Instalação do tapume da loja LEGO',
    slug: 'tapumes',
    message: 'Olá! Gostaria de um orçamento para tapume, lona ou banner.',
  },
  {
    title: 'Adesivos & etiquetas',
    description: 'Rótulos, etiquetas e adesivos personalizados para produtos, embalagens e brindes.',
    tags: ['Etiquetas', 'Rótulos', 'Adesivos', 'Recorte eletrônico'],
    image: 'etiquetas-cb8d7103-84f9-43a1-a99c-ab77af361841',
    alt: 'Cartela de etiquetas redondas impressas',
    slug: 'etiquetas',
    message: 'adesivos',
  },
  {
    title: 'Gráfica rápida',
    description: 'Cartões de visita, panfletos, blocos e impressos do dia a dia, com agilidade.',
    tags: ['Cartões de visita', 'Panfletos', 'Blocos', 'Encadernação'],
    image: 'blocos-446d5a03-dbde-463f-9cb0-909077d3be96',
    alt: 'Blocos personalizados impressos',
    slug: 'blocos',
    message: 'grafica',
  },
];
---

<section id="servicos" class="sec services" aria-labelledby="services-title">
  <div class="wrap">
    <p class="rule"><span><b>Serviços</b></span><Icon name="reg" class="reg-mark" /></p>

    <div class="services-head">
      <SplitText id="services-title" class="display t-h2" text="Tudo que a sua marca precisa para *ser vista.*" />
      <div class="services-aside" data-reveal style="--d:.2s">
        <p class="lede">Do cartão de visita ao envelopamento de frotas inteiras. A gente produz, instala em BH e região e envia para todo o Brasil.</p>
        <Button href={getWhatsAppLink('default')} label="Pedir orçamento" icon="whatsapp" variant="line" external />
      </div>
    </div>

    <ol class="svc-list" data-services>
      {services.map((service, index) => (
        <li class="svc" data-index={index} data-reveal style={`--d:${(index % 3) * 0.06}s`}>
          <span class="svc-num mono">{String(index + 1).padStart(2, '0')}</span>
          <div class="svc-main">
            <h3 class="svc-title">{service.title}</h3>
            <p class="svc-desc">{service.description}</p>
            <ul class="svc-tags" aria-label={`Exemplos de ${service.title.toLowerCase()}`}>
              {service.tags.map(tag => <li class="tag">{tag}</li>)}
            </ul>
          </div>
          <figure class="svc-thumb media">
            <img src={optimized(service.image, 480)} alt={service.alt} width="480" height="360" loading="lazy" decoding="async" />
          </figure>
          <div class="svc-actions">
            <a href={getWhatsAppLink(service.message)} target="_blank" rel="noopener noreferrer" class="svc-link svc-link-main">
              Orçar <Icon name="arrow-up-right" />
            </a>
            <a href={`/portfolio#${service.slug}`} class="svc-link u-link tap">Ver trabalhos</a>
          </div>
        </li>
      ))}
    </ol>
  </div>

</section>

<style>
  .services-head {
    display: grid; gap: 1.25rem; justify-items: start; max-width: 52rem;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  }
  .services-aside { display: grid; gap: 1.6rem; justify-items: start; }

  .svc-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .6rem;
    padding: clamp(1.6rem, 3vw, 2.4rem) 0;
    border-bottom: 1px solid var(--line-strong);
    isolation: isolate;
  }
  .svc::before {
    content: ""; position: absolute; inset: 0 calc(var(--gutter) * -1); z-index: -1;
    background: var(--color-paper-2);
    clip-path: inset(100% 0 0 0);
    transition: clip-path .7s var(--ease-expo);
  }
  .svc-num { font-size: .75rem; font-weight: 600; letter-spacing: .1em; color: var(--title-accent); transition: color .4s; }
  .svc-title {
    font-family: var(--font-sans); font-weight: 600;
    font-size: clamp(1.4rem, 2.1vw, 1.9rem); line-height: 1.15; letter-spacing: -0.02em;
    transition: transform .8s var(--ease-expo);
  }
  .svc-desc { margin-top: .6rem; max-width: 34rem; color: var(--color-ink-2); }
  .svc-tags { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; margin: 1.1rem 0 0; padding: 0; }

  .svc-thumb { aspect-ratio: 16 / 9; border-radius: 10px; margin: .8rem 0 0; max-width: 28rem; }

  .svc-actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 1.2rem; }
  .svc-link { display: inline-flex; align-items: center; gap: .35rem; font-weight: 600; font-size: .95rem; }
  .svc-link :global(svg) { width: 1rem; height: 1rem; transition: transform .5s var(--ease-expo); }
  .svc-link-main {
    padding: .7rem 1.1rem; border-radius: 999px;
    background: var(--color-ink); color: var(--color-paper);
    transition: background-color .3s;
  }
  .svc-link-main:hover { background: var(--color-magenta); color: #fff; }
  .svc-link-main:hover :global(svg) { transform: rotate(45deg); }

  /* Computador: catálogo em duas colunas (seis serviços em três linhas) na altura
     que sobra da tela; o número vai sobre a foto e as etiquetas ficam só no celular. */
  @media (min-width: 1024px) {
    .services-head { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: end; column-gap: clamp(2.5rem, 6vw, 6rem); max-width: none; margin-bottom: clamp(1.5rem, 4.5vh, 3rem); }
    .services-aside :global(.btn) { display: none; } /* cada serviço já tem o seu "Orçar" */
    .svc-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 4vw, 4rem); }
    .svc {
      --h: clamp(6.5rem, calc((var(--frame) - 11rem) / 3 - 1.5rem), 10rem);
      grid-template-columns: calc(var(--h) * 4 / 3) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: "thumb main" "thumb actions";
      gap: .6rem 1.25rem;
      padding-block: .75rem;
    }
    .svc::before { inset: 0 -.75rem; border-radius: 12px; }
    .svc-num {
      position: absolute; z-index: 1; top: 1.2rem; left: .45rem;
      padding: .15rem .4rem; border-radius: 6px;
      background: rgb(22 18 14 / 72%); color: #fff; font-size: var(--fs-micro);
    }
    .svc-main { grid-area: main; }
    .svc-title { font-size: clamp(1.15rem, 1.5vw, 1.4rem); }
    .svc-desc { margin-top: .35rem; font-size: .95rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .svc-tags { display: none; }
    .svc-thumb { grid-area: thumb; width: 100%; height: var(--h); max-width: none; margin: 0; aspect-ratio: auto; border-radius: 8px; }
    .svc-actions { grid-area: actions; gap: 1.1rem; margin-top: 0; }
    .svc-link-main { padding: .5rem .95rem; }
  }
  @media (min-width: 1024px) and (max-height: 800px) {
    .svc-desc { -webkit-line-clamp: 1; }
  }

  @media (hover: hover) and (min-width: 1024px) {
    .svc:hover::before { clip-path: inset(0 0 0 0); }
    .svc:hover .svc-title { transform: translate3d(.4rem, 0, 0); }
  }

  @media (min-width: 1024px) and (max-height: 700px) {
    .svc { --h: 5.75rem; }
    .svc-desc { display: none; }
  }
</style>
